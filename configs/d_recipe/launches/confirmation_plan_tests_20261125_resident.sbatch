#!/usr/bin/python3 -ISB
#SBATCH --job-name=D-cold9M-tests
#SBATCH --partition=cpu
#SBATCH --exclude=compute-0-[0-7,20-22]
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=1G
#SBATCH --time=00:10:00
#SBATCH --output=/share/home/zixiao/descriptor_analysis/runs/d_recipe_20261120/D_cold9M_tests_%j.out
import os,sys,json,time,math,re,subprocess,types
from pathlib import Path
os.environ.update(CUDA_VISIBLE_DEVICES="",PYTHONDONTWRITEBYTECODE="1",
    OMP_NUM_THREADS="1",OPENBLAS_NUM_THREADS="1",MKL_NUM_THREADS="1")
node=os.uname().nodename.split(".")[0]
if node not in {"compute-0-"+str(i) for i in range(8,20)} or os.getuid()!=1278:
    raise RuntimeError("Registered CPU node and UID required")
job=os.environ["SLURM_JOB_ID"]
info=subprocess.run(["/usr/bin/scontrol","show","job","-o",job],capture_output=True,text=True,check=True,timeout=8).stdout
end=re.search(r"\bEndTime=(\S+)",info).group(1)
end_epoch=time.mktime(time.strptime(end,"%Y-%m-%dT%H:%M:%S"))
facts={}
for p in ("/","/share/home/zixiao/descriptor_analysis/runs/d_recipe_20261120"):
    f=os.statvfs(p);facts[p]=dict(total=f.f_blocks*f.f_frsize,available=f.f_bavail*f.f_frsize,inodes=f.f_favail)
root=facts["/"]
if root["available"]<max(10*2**30,math.ceil(.1*root["total"])) or root["inodes"]<10000:
    raise RuntimeError("Actual root system headroom insufficient")
share=facts["/share/home/zixiao/descriptor_analysis/runs/d_recipe_20261120"]
if share["available"]<100000000000+2**20 or share["inodes"]<10000:
    raise RuntimeError("Actual shared filesystem headroom insufficient for <=1MiB source/test log")
print("D_COLD9M_TEST_ENTRY="+json.dumps(dict(job=job,node=node,UID=os.getuid(),pid=os.getpid(),TimeLimit="00:10:00",EndTime=end,cleanup_seconds=180,local_output_bytes=0,log_reserve_bytes=2**20,facts=facts)),flush=True)
m=types.ModuleType("d_frozen_test_exit_lifecycle");sys.modules[m.__name__]=m
exec("\"\"\"Own-process cleanup for future D entries; scientific runners stay unchanged.\n\nThis module is inactive until an entry explicitly calls supervise().  It never\nuses SIGKILL.  A kernel-stuck process is reported for administrator recovery.\n\"\"\"\nimport ctypes\nfrom dataclasses import dataclass\nimport os\nfrom pathlib import Path\nimport signal\nimport time\n\n\n@dataclass(frozen=True)\nclass Identity:\n    pid: int\n    start_ticks: int\n    uids: tuple\n    cgroup: str\n    state: str\n\n\ndef identity(pid):\n    try:\n        raw = Path(\"/proc/%d/stat\" % pid).read_text()\n        fields = raw[raw.rfind(\")\") + 2:].split()\n        status = Path(\"/proc/%d/status\" % pid).read_text().splitlines()\n        uids = tuple(int(v) for v in next(\n            line for line in status if line.startswith(\"Uid:\")).split()[1:])\n        return Identity(pid, int(fields[19]), uids,\n                        Path(\"/proc/%d/cgroup\" % pid).read_text(), fields[0])\n    except (FileNotFoundError, ProcessLookupError):\n        return None\n\n\ndef same_process(expected, actual):\n    return (actual is not None and expected.pid == actual.pid\n            and expected.start_ticks == actual.start_ticks\n            and expected.uids == actual.uids)\n\n\ndef owned_scope(record, uid, scope):\n    return (record is not None and record.uids == (uid,) * 4\n            and scope in record.cgroup.splitlines()\n            and record.state not in (\"Z\", \"X\"))\n\n\ndef signal_owned(expected, sig, *, uid, scope):\n    \"\"\"Bind a signal to UID/start_ticks/exact cgroup, using pidfd when present.\"\"\"\n    current = identity(expected.pid)\n    if not same_process(expected, current) or not owned_scope(current, uid, scope):\n        return False\n    if hasattr(os, \"pidfd_open\") and hasattr(signal, \"pidfd_send_signal\"):\n        try:\n            fd = os.pidfd_open(expected.pid, 0)\n        except ProcessLookupError:\n            return False\n        try:\n            current = identity(expected.pid)\n            if not same_process(expected, current) or not owned_scope(current, uid, scope):\n                return False\n            signal.pidfd_send_signal(fd, sig)\n        finally:\n            os.close(fd)\n    else:\n        current = identity(expected.pid)\n        if not same_process(expected, current) or not owned_scope(current, uid, scope):\n            return False\n        try:\n            os.kill(expected.pid, sig)\n        except ProcessLookupError:\n            return False\n    return True\n\n\ndef children(pid):\n    result = set()\n    try:\n        tasks = list(Path(\"/proc/%d/task\" % pid).iterdir())\n    except (FileNotFoundError, ProcessLookupError):\n        return result\n    for task in tasks:\n        try:\n            result.update(int(v) for v in (task / \"children\").read_text().split())\n        except (FileNotFoundError, ProcessLookupError):\n            continue\n    return result\n\n\ndef descendants(pid):\n    found, pending = {}, list(children(pid))\n    while pending:\n        child = pending.pop()\n        if child in found:\n            continue\n        record = identity(child)\n        if record is None:\n            continue\n        found[child] = record\n        pending.extend(children(child))\n    return found\n\n\ndef enable_subreaper():\n    libc = ctypes.CDLL(None, use_errno=True)\n    if libc.prctl(36, 1, 0, 0, 0) != 0:\n        raise OSError(ctypes.get_errno(), \"PR_SET_CHILD_SUBREAPER failed\")\n\n\ndef reap_adopted(exclude):\n    for pid in children(os.getpid()) - set(exclude):\n        record = identity(pid)\n        if record is not None and record.state not in (\"Z\", \"X\"):\n            continue\n        try:\n            os.waitpid(pid, os.WNOHANG)\n        except ChildProcessError:\n            continue\n\n\ndef slurm_scope(job_id):\n    record = identity(os.getpid())\n    if record is None:\n        raise RuntimeError(\"Own process identity unavailable\")\n    for line in record.cgroup.splitlines():\n        path = line.split(\":\", 2)[-1]\n        if \"/job_%s/\" % job_id in path:\n            return line\n    raise RuntimeError(\"Real Slurm job/step cgroup is required\")\n\n\ndef cleanup_seconds(value):\n    if type(value) is not int or value < 180:\n        raise ValueError(\"Reserve at least180seconds before the real TimeLimit\")\n    return value\n\n\ndef supervise(command, *, end_epoch, scope, grace_seconds=900,\n              request_stop=None, poll_seconds=.25, stop_state=None, report=print):\n    \"\"\"Run once, request a safe boundary, then TERM and reap every owned child.\n\n    end_epoch must come from the actual allocation, or None for UNLIMITED.\n    request_stop may create a cooperative handoff and return its Popen handle;\n    that metadata helper is supervised as well.  A stop returns75, never a\n    successful scientific completion.  An unresolved exit remains supervised\n    and is reported once; it is not declared clean from a batch exit code.\n    \"\"\"\n    import subprocess\n\n    grace = cleanup_seconds(grace_seconds)\n    if not 0 < poll_seconds <= 5:\n        raise ValueError(\"Bounded process-observation interval required\")\n    if end_epoch is not None and end_epoch - time.time() <= grace:\n        raise RuntimeError(\"No work may start inside the cleanup window\")\n    job_id = os.environ.get(\"SLURM_JOB_ID\")\n    if not job_id or scope != slurm_scope(job_id):\n        raise RuntimeError(\"Use the exact current allocation/step scope\")\n    enable_subreaper()\n    uid = os.getuid()\n    if uid == 0:\n        raise RuntimeError(\"D supervisor must run as the actual non-root user\")\n    flags = stop_state if stop_state is not None else {}\n    old_handlers = {}\n    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGUSR1):\n        old_handlers[sig] = signal.getsignal(sig)\n        signal.signal(sig, lambda received, frame: flags.setdefault(\"signal\", received))\n    root = None\n    helpers, terminated = [], set()\n    stopping = None\n    reported_unresolved = False\n    term_at = None\n    try:\n        root = subprocess.Popen(command, start_new_session=True)\n        while True:\n            now = time.time()\n            root.poll()\n            for helper in helpers:\n                helper.poll()\n            reap_adopted([root.pid] + [p.pid for p in helpers])\n            tree = descendants(os.getpid())\n            active = {pid: rec for pid, rec in tree.items()\n                      if rec.state not in (\"Z\", \"X\")}\n            if stopping is None and (flags or\n                    (end_epoch is not None and now >= end_epoch - grace)):\n                stopping = now\n                reason = (\"SIGNAL_%s\" % flags.get(\"signal\") if flags\n                          else \"ALLOCATION_CLEANUP_WINDOW\")\n                report({\"phase\": \"STOP_DISPATCH_REQUESTED\", \"reason\": reason})\n                if request_stop is not None and root.returncode is None:\n                    helper = request_stop()\n                    if helper is not None:\n                        helpers.append(helper)\n                # TERM/INT can be followed by a short site KillWait.  Deadline\n                # or USR1 gives the full preregistered cleanup reservation.\n                immediate = flags.get(\"signal\") in (signal.SIGTERM, signal.SIGINT)\n                term_at = (now + 10 if immediate else\n                           (end_epoch - max(180, grace // 3)\n                            if end_epoch is not None else now + grace * 2 / 3))\n                if request_stop is None:\n                    term_at = now\n            # A normal runner must not leave stopped/orphaned descendants.\n            if root.returncode is not None and term_at is None:\n                term_at = now\n            if term_at is not None and now >= term_at:\n                for pid, rec in active.items():\n                    key = (pid, rec.start_ticks)\n                    if key in terminated:\n                        continue\n                    if signal_owned(rec, signal.SIGTERM, uid=uid, scope=scope):\n                        terminated.add(key)\n                        report({\"phase\": \"OWNED_TERM\", \"pid\": pid,\n                                \"start_ticks\": rec.start_ticks})\n                        # Let a stopped worker consume its pending TERM; do\n                        # not resume it in advance of the exit request.\n                        if rec.state in (\"T\", \"t\"):\n                            signal_owned(rec, signal.SIGCONT, uid=uid, scope=scope)\n            root.poll()\n            for helper in helpers:\n                helper.poll()\n            reap_adopted([root.pid] + [p.pid for p in helpers])\n            remaining = descendants(os.getpid())\n            if (root.returncode is not None and\n                    all(p.returncode is not None for p in helpers) and\n                    not remaining):\n                report({\"phase\": \"OWNED_TREE_REAPED\", \"root\": root.pid,\n                        \"root_returncode\": root.returncode})\n                return 75 if stopping is not None else root.returncode\n            if (end_epoch is not None and now >= end_epoch - 180\n                    and not reported_unresolved):\n                reported_unresolved = True\n                report({\"phase\": \"ADMIN_REQUIRED_EXIT_NOT_PROVEN\",\n                        \"pids\": sorted(remaining), \"no_SIGKILL\": True})\n            time.sleep(poll_seconds)\n    finally:\n        # Do not hide a failed control path or leave a descendant from an\n        # exception. Keep supervising after one TERM while the parent can reap.\n        if root is not None:\n            while True:\n                for rec in descendants(os.getpid()).values():\n                    key = (rec.pid, rec.start_ticks)\n                    if key not in terminated and owned_scope(rec, uid, scope):\n                        if signal_owned(rec, signal.SIGTERM, uid=uid, scope=scope):\n                            terminated.add(key)\n                            if rec.state in (\"T\", \"t\"):\n                                signal_owned(rec, signal.SIGCONT, uid=uid, scope=scope)\n                root.poll()\n                for helper in helpers:\n                    helper.poll()\n                reap_adopted([root.pid] + [p.pid for p in helpers])\n                if (root.returncode is not None\n                        and all(p.returncode is not None for p in helpers)\n                        and not descendants(os.getpid())):\n                    break\n                time.sleep(poll_seconds)\n        for sig, handler in old_handlers.items():\n            signal.signal(sig, handler)\n",m.__dict__)
scope=m.slurm_scope(job)
rc=m.supervise(["/usr/bin/python3","-ISB","-c","import sys,os,json,types,unittest,time\nfrom pathlib import Path\nroot=\"/share/home/zixiao/descriptor_analysis/MFM_d_recipe\"\nsys.path.insert(0,root)\ns=Path(\"/proc/self/stat\").read_text();fields=s[s.rfind(\")\")+2:].split()\nprint(\"D_COLD9M_TEST_WORKER=\"+json.dumps(dict(pid=os.getpid(),UID=os.getuid(),start_ticks=int(fields[19]),cgroup=Path(\"/proc/self/cgroup\").read_text())),flush=True)\nmod=types.ModuleType(\"tools.d_recipe.confirmation_plan\");mod.__package__=\"tools.d_recipe\";mod.__file__=root+\"/tools/d_recipe/confirmation_plan.py\";sys.modules[mod.__name__]=mod\nexec(\"\\\"\\\"\\\"Prepare only the taskbook's cold seed0 confirmations after recipe freeze.\\n\\nPure configuration planning: no files, weights, feature tensors, fitting or job\\nsubmission. The scheduler must bind and admit new runtime resources before use.\\n\\\"\\\"\\\"\\nfrom copy import deepcopy\\nfrom pathlib import Path\\n\\nfrom .training import ARMS, prepare_runtime\\n\\n\\n_EXECUTION_KEYS = (\\n    \\\"resume\\\", \\\"resume_samples\\\", \\\"resume_from_output\\\", \\\"attempt\\\", \\\"handoff_request\\\",\\n    \\\"handoff_ack\\\", \\\"required_gpu_uuid\\\", \\\"recovery_reason\\\", \\\"replaces_run\\\",\\n    \\\"source_last_samples\\\", \\\"rollback_samples\\\", \\\"infrastructure_continuation\\\",\\n    \\\"seed0_run\\\", \\\"diagnostic_feature_root\\\", \\\"checkpoint\\\", \\\"features\\\",\\n    \\\"persist_features\\\", \\\"recipe_preparation_only\\\", \\\"node\\\", \\\"local_node\\\",\\n    \\\"gpu_uuid\\\", \\\"execution\\\", \\\"local_storage\\\", \\\"local_output_root\\\",\\n    \\\"local_storage_peak_bytes\\\", \\\"local_concurrent_bytes\\\", \\\"storage_peak_bytes\\\",\\n    \\\"share_storage_peak_bytes\\\", \\\"root_joint_future_bytes\\\", \\\"lustre_other_future_bytes\\\",\\n    \\\"output_filesystem\\\", \\\"model_budget_root\\\", \\\"storage_forecast_basis\\\",\\n    \\\"minimum_free_gpu_mib\\\", \\\"cleanup_seconds\\\", \\\"speed_calibration\\\",\\n    \\\"calibration_training\\\", \\\"benchmark_updates\\\", \\\"speed_board\\\",\\n)\\n\\n\\ndef _screening(parent):\\n    if (parent.get(\\\"condition\\\") != \\\"D\\\" or parent.get(\\\"arm\\\") not in ARMS\\n            or parent[\\\"arm\\\"].startswith(\\\"9M-\\\") or parent.get(\\\"seed\\\") != 0\\n            or parent.get(\\\"samples\\\") != 3_000_000):\\n        raise ValueError(\\\"Confirmation uses a registered seed0 3M D condition\\\")\\n    return deepcopy(parent)\\n\\n\\ndef _cold(parent, arm, *, output_root, run_prefix, retain_h0):\\n    c = deepcopy(parent)\\n    for key in _EXECUTION_KEYS:\\n        c.pop(key, None)\\n    c.update(arm=arm, run=run_prefix + arm.replace(\\\"-\\\", \\\"_\\\") + \\\"_seed0\\\",\\n        seed=0, samples=9_000_000, round=0, stage=4,\\n        output=str(Path(output_root) / arm / \\\"training\\\"),\\n        evaluation_samples=[9_000_000], statistics_backend=\\\"slurm_cpu\\\",\\n        persist_final_features=retain_h0, resource_admission_pending=True,\\n        confirmation_source_run=parent[\\\"run\\\"])\\n    # A cold run measures its own window; no fitted screening state survives.\\n    c[\\\"clip_calibration\\\"] = dict(calibration_samples=150000,\\n        window_start_samples=60000, initial_clip=281.7, quantile=.99,\\n        sample_axis=\\\"optimizer_step_start\\\")\\n    binding = c[\\\"d_recipe\\\"].setdefault(\\\"scientific_binding\\\", {})\\n    for key in (\\\"arm\\\", \\\"seed\\\", \\\"samples\\\"):\\n        binding.pop(key, None)\\n    return prepare_runtime(c)\\n\\n\\ndef plan_confirmation(best, baseline, selected=None, *, output_root, run_prefix):\\n    \\\"\\\"\\\"Return R0 always, and final only when it differs; no seed1 confirmation.\\n\\n    Selected is the final scientific configuration frozen after all gates,\\n    including any adopted mask or 3D decision. No recipe selection happens here.\\n    Existing TRAIN parameters and all model settings stay unchanged.\\n    Output resources and target hardware are deliberately unbound in this plan.\\n    \\\"\\\"\\\"\\n    if best.get(\\\"status\\\") != \\\"FROZEN\\\" or best.get(\\\"recipe_frozen\\\") is not True:\\n        raise ValueError(\\\"All D decisions and the final recipe freeze precede confirmation\\\")\\n    baseline = _screening(baseline)\\n    if (baseline[\\\"arm\\\"] != \\\"D-R0\\\" or baseline.get(\\\"components\\\")\\n            or not baseline[\\\"d_recipe\\\"].get(\\\"include_3d\\\", True)\\n            or baseline[\\\"d_recipe\\\"].get(\\\"graph_mask_enabled\\\", False)):\\n        raise ValueError(\\\"The confirmation baseline is the original D-R0 condition\\\")\\n    if best.get(\\\"arm\\\") == \\\"D-R0\\\":\\n        selected = baseline\\n    elif selected is None:\\n        raise ValueError(\\\"The frozen selected scientific configuration is required\\\")\\n    else:\\n        selected = _screening(selected)\\n    if (selected[\\\"arm\\\"] != best.get(\\\"arm\\\")\\n            or selected[\\\"d_recipe\\\"][\\\"library\\\"] != best.get(\\\"library\\\")):\\n        raise ValueError(\\\"Selected condition differs from the frozen D recipe\\\")\\n    if \\\"components\\\" in best and set(selected.get(\\\"components\\\", ())) != set(best[\\\"components\\\"]):\\n        raise ValueError(\\\"Selected components differ from the frozen D recipe\\\")\\n    same = best[\\\"arm\\\"] == \\\"D-R0\\\"\\n    configurations = [_cold(baseline, \\\"9M-D-R0\\\", output_root=output_root,\\n        run_prefix=run_prefix, retain_h0=same)]\\n    if not same:\\n        configurations.append(_cold(selected, \\\"9M-D-final\\\", output_root=output_root,\\n            run_prefix=run_prefix, retain_h0=True))\\n    return dict(schema=\\\"D_COLD_CONFIRMATION_PLAN_V1\\\",\\n        status=\\\"SCIENTIFIC_CONFIGURATIONS_REQUIRE_RUNTIME_RESOURCE_ADMISSION\\\",\\n        frozen_arm=best[\\\"arm\\\"], frozen_library=best[\\\"library\\\"],\\n        selected_readout_arm=\\\"9M-D-R0\\\" if same else \\\"9M-D-final\\\",\\n        configurations=configurations, jobs_submitted=False)\\n\",mod.__dict__)\ntest=types.ModuleType(\"d_cold9m_frozen_tests\");test.__file__=root+\"/tests/test_d_recipe_confirmation_plan.py\";sys.modules[test.__name__]=test\nexec(\"\\\"\\\"\\\"Cold D confirmation contracts; no tensors, training or actual filesystem I/O.\\\"\\\"\\\"\\nfrom copy import deepcopy\\nfrom pathlib import Path\\nimport sys\\nimport unittest\\n\\nROOT = Path(__file__).resolve().parents[1]\\nsys.path.insert(0, str(ROOT))\\nfrom tools.d_recipe.confirmation_plan import plan_confirmation\\nfrom tools.d_recipe.train import final_readout\\n\\n\\ndef screening(arm=\\\"D-R0\\\"):\\n    return dict(condition=\\\"D\\\", arm=arm, run=arm + \\\"_seed0\\\", seed=0, samples=3_000_000,\\n        batch_size=32, microbatch_size=32, lr=3e-4, weight_decay=.01,\\n        betas=[.9, .95], warmup_fraction=.02, distance_bias=\\\"C1-0\\\", schedule=\\\"cosine\\\",\\n        components=[] if arm == \\\"D-R0\\\" else [\\\"A1\\\", \\\"B3\\\", \\\"B4\\\"],\\n        p_recipe={}, clip_calibration=dict(calibration_samples=150000,\\n            window_start_samples=60000, initial_clip=281.7, quantile=.99),\\n        output=\\\"/screen/\\\" + arm, readout_store=\\\"/native_store.json\\\",\\n        reference_manifest=\\\"/random_reference.json\\\", source=\\\"PM7\\\",\\n        d_recipe=dict(enabled=True, library=\\\"L1\\\" if arm == \\\"D-L1\\\" else \\\"D20\\\",\\n            include_3d=True, graph_mask_enabled=False,\\n            block_weights=dict(graph_2d=.6, molecule_3d=.3, atom_sasa=.1),\\n            label_parameters=\\\"/frozen_TRAIN_parameters.json\\\"))\\n\\n\\ndef frozen(arm=\\\"D-R0\\\"):\\n    return dict(status=\\\"FROZEN\\\", recipe_frozen=True, arm=arm,\\n        library=\\\"L1\\\" if arm == \\\"D-L1\\\" else \\\"D20\\\",\\n        components=[] if arm == \\\"D-R0\\\" else [\\\"A1\\\", \\\"B3\\\", \\\"B4\\\"])\\n\\n\\ndef plan(best=None, baseline=None, selected=None):\\n    return plan_confirmation(best or frozen(), baseline or screening(), selected,\\n        output_root=\\\"/confirmation\\\", run_prefix=\\\"d_\\\")\\n\\n\\nclass ConfirmationPlanTests(unittest.TestCase):\\n    def test_unfinished_recipe_never_prepares_confirmation(self):\\n        for changes in (dict(status=\\\"RUNNING\\\"), dict(recipe_frozen=False)):\\n            best = frozen()\\n            best.update(changes)\\n            with self.assertRaisesRegex(ValueError, \\\"freeze\\\"):\\n                plan(best)\\n\\n    def test_native_selection_requests_only_one_cold_run_and_retains_its_h0(self):\\n        result = plan()\\n        self.assertEqual([c[\\\"arm\\\"] for c in result[\\\"configurations\\\"]], [\\\"9M-D-R0\\\"])\\n        c = result[\\\"configurations\\\"][0]\\n        self.assertEqual((c[\\\"seed\\\"], c[\\\"samples\\\"]), (0, 9_000_000))\\n        self.assertEqual(c[\\\"checkpoint_samples\\\"], list(range(1_000_000, 9_000_001, 1_000_000)))\\n        self.assertEqual(c[\\\"evaluation_samples\\\"], [9_000_000])\\n        self.assertTrue(c[\\\"persist_final_features\\\"])\\n        self.assertFalse(result[\\\"jobs_submitted\\\"])\\n\\n    def test_transferred_selection_keeps_original_baseline_and_only_selected_h0(self):\\n        original, selected, best = screening(), screening(\\\"D-L1\\\"), frozen(\\\"D-L1\\\")\\n        before = deepcopy((original, selected, best))\\n        result = plan(best, original, selected)\\n        a, b = result[\\\"configurations\\\"]\\n        self.assertEqual((a[\\\"arm\\\"], b[\\\"arm\\\"]), (\\\"9M-D-R0\\\", \\\"9M-D-final\\\"))\\n        self.assertEqual((a[\\\"d_recipe\\\"][\\\"library\\\"], b[\\\"d_recipe\\\"][\\\"library\\\"]), (\\\"D20\\\", \\\"L1\\\"))\\n        self.assertFalse(a[\\\"persist_final_features\\\"])\\n        self.assertTrue(b[\\\"persist_final_features\\\"])\\n        self.assertEqual(b[\\\"d_recipe\\\"][\\\"label_parameters\\\"], \\\"/frozen_TRAIN_parameters.json\\\")\\n        self.assertEqual(b[\\\"d_recipe\\\"][\\\"scientific_binding\\\"][\\\"samples\\\"], 9_000_000)\\n        self.assertEqual((original, selected, best), before)\\n\\n    def test_old_resume_cache_runtime_and_fitted_clip_state_do_not_survive(self):\\n        selected = screening(\\\"D-L1\\\")\\n        selected.update(resume=\\\"/old.pt\\\", resume_samples=1000000,\\n            resume_from_output=\\\"/old\\\", handoff_ack=\\\"/ack\\\", diagnostic_feature_root=\\\"/3M/cache\\\",\\n            checkpoint=\\\"/3M.pt\\\", features=\\\"/old_features\\\", infrastructure_continuation={},\\n            storage_peak_bytes=1, share_storage_peak_bytes=2, node=\\\"old_node\\\", gpu_uuid=\\\"old_gpu\\\",\\n            local_output_root=\\\"/old_node/cache\\\", local_storage_peak_bytes=3, local_concurrent_bytes=4)\\n        selected[\\\"clip_calibration\\\"].update(threshold=123., fitted=True, observed_updates=2813)\\n        c = plan(frozen(\\\"D-L1\\\"), selected=selected)[\\\"configurations\\\"][1]\\n        for key in (\\\"resume\\\", \\\"resume_samples\\\", \\\"resume_from_output\\\", \\\"handoff_ack\\\",\\n                \\\"diagnostic_feature_root\\\", \\\"checkpoint\\\", \\\"features\\\", \\\"infrastructure_continuation\\\",\\n                \\\"storage_peak_bytes\\\", \\\"share_storage_peak_bytes\\\", \\\"node\\\", \\\"gpu_uuid\\\",\\n                \\\"local_output_root\\\", \\\"local_storage_peak_bytes\\\", \\\"local_concurrent_bytes\\\"):\\n            self.assertNotIn(key, c)\\n        self.assertTrue(c[\\\"resource_admission_pending\\\"])\\n        self.assertNotIn(\\\"fitted\\\", c[\\\"clip_calibration\\\"])\\n        self.assertNotIn(\\\"threshold\\\", c[\\\"clip_calibration\\\"])\\n        self.assertEqual(c[\\\"clip_calibration\\\"][\\\"window_start_samples\\\"], 60000)\\n\\n    def test_final_readout_uses_new_endpoint_and_retention_switch(self):\\n        c = plan(frozen(\\\"D-L1\\\"), selected=screening(\\\"D-L1\\\"))[\\\"configurations\\\"][1]\\n        readout = final_readout(c, lambda config, samples: \\\"/new/samples_\\\" + str(samples) + \\\".pt\\\")\\n        self.assertEqual(readout[\\\"checkpoint\\\"], \\\"/new/samples_9000000.pt\\\")\\n        self.assertEqual(readout[\\\"features\\\"], \\\"/confirmation/9M-D-final/training/features_9000000\\\")\\n        self.assertTrue(readout[\\\"persist_features\\\"])\\n        self.assertNotIn(\\\"diagnostic_feature_root\\\", readout)\\n\\n    def test_only_registered_seed0_screening_sources_can_prepare_confirmation(self):\\n        for changes in (dict(seed=1), dict(samples=9_000_000), dict(arm=\\\"9M-D-final\\\")):\\n            selected = screening(\\\"D-L1\\\")\\n            selected.update(changes)\\n            with self.assertRaisesRegex(ValueError, \\\"seed0 3M\\\"):\\n                plan(frozen(\\\"D-L1\\\"), selected=selected)\\n\\n    def test_frozen_library_or_components_mismatch_is_not_silently_changed(self):\\n        for changes in (dict(library=\\\"L2\\\"), dict(components=[])):\\n            best = frozen(\\\"D-L1\\\")\\n            best.update(changes)\\n            with self.assertRaisesRegex(ValueError, \\\"frozen D recipe\\\"):\\n                plan(best, selected=screening(\\\"D-L1\\\"))\\n\\n    def test_adopted_mask_seed_is_preserved_for_a_fresh_confirmation(self):\\n        selected = screening(\\\"D-K1\\\")\\n        selected[\\\"d_recipe\\\"].update(library=\\\"L1\\\", adopted_wide=True,\\n            graph_mask_enabled=True, mask_seed=20261119)\\n        best = frozen(\\\"D-K1\\\")\\n        best[\\\"library\\\"] = \\\"L1\\\"\\n        c = plan(best, selected=selected)[\\\"configurations\\\"][1]\\n        self.assertTrue(c[\\\"d_recipe\\\"][\\\"graph_mask_enabled\\\"])\\n        self.assertEqual(c[\\\"d_recipe\\\"][\\\"mask_seed\\\"], 20261119)\\n        self.assertTrue(c[\\\"d_recipe\\\"][\\\"include_3d\\\"])\\n\\n    def test_frozen_wide_and_geometry_decisions_can_be_composed_only_in_final(self):\\n        selected = screening(\\\"D-L1\\\")\\n        selected[\\\"d_recipe\\\"][\\\"include_3d\\\"] = False\\n        a, b = plan(frozen(\\\"D-L1\\\"), selected=selected)[\\\"configurations\\\"]\\n        self.assertTrue(a[\\\"d_recipe\\\"][\\\"include_3d\\\"])\\n        self.assertFalse(b[\\\"d_recipe\\\"][\\\"include_3d\\\"])\\n        self.assertEqual(b[\\\"d_recipe\\\"][\\\"block_weights\\\"], selected[\\\"d_recipe\\\"][\\\"block_weights\\\"])\\n\\n    def test_native_baseline_cannot_be_replaced_by_a_transferred_condition(self):\\n        with self.assertRaisesRegex(ValueError, \\\"original D-R0\\\"):\\n            plan(baseline=screening(\\\"D-R1\\\"))\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    unittest.main()\\n\",test.__dict__)\nstart=time.monotonic();suite=unittest.defaultTestLoader.loadTestsFromModule(test)\nresult=unittest.TextTestRunner(verbosity=2).run(suite)\nprint(\"D_COLD9M_TEST_RESULT=\"+json.dumps(dict(tests=result.testsRun,failures=len(result.failures),errors=len(result.errors),skipped=len(result.skipped),native_seconds=time.monotonic()-start)),flush=True)\nraise SystemExit(0 if result.wasSuccessful() else 1)\n"],
    end_epoch=end_epoch,scope=scope,grace_seconds=180,
    report=lambda x:print(json.dumps(x),flush=True))
