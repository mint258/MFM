"D-L1-stage2-A1\\\",\\\"state\\\":\\\"RUNNING\\\",\\\"exit_code\\\":\\\"0:0\\\",\\\"elapsed_seconds\\\":3525,\\\"allocated_CPUs\\\":1,\\\"TotalCPU_raw\\\":\\\"00:00:00\\\",\\\"node\\\":\\\"compute-0-11\\\",\\\"partition\\\":\\\"cpu\\\",\\\"start_CST\\\":\\\"2026-11-23T04:50:12\\\",\\\"end_CST\\\":\\\"Unknown\\\",\\\"workdir\\\":\\\"/\\\",\\\"scope_evidence\\\":[\\\"submission_path_D_recipe\\\",\\\"registered_D_document_and_namespace\\\"]},{\\\"job_id\\\":\\\"4539169\\\",\\\"job_name\\\":\\\"D-L2-stage2-A1\\\",\\\"state\\\":\\\"RUNNING\\\",\\\"exit_code\\\":\\\"0:0\\\",\\\"elapsed_seconds\\\":3380,\\\"allocated_CPUs\\\":1,\\\"TotalCPU_raw\\\":\\\"00:00:00\\\",\\\"node\\\":\\\"compute-0-11\\\",\\\"partition\\\":\\\"cpu\\\",\\\"start_CST\\\":\\\"2026-11-23T04:52:37\\\",\\\"end_CST\\\":\\\"Unknown\\\",\\\"workdir\\\":\\\"/\\\",\\\"scope_evidence\\\":[\\\"submission_path_D_recipe\\\",\\\"registered_D_document_and_namespace\\\"]},{\\\"job_id\\\":\\\"4539171\\\",\\\"job_name\\\":\\\"D-seed1-costs-CPU\\\",\\\"state\\\":\\\"COMPLETED\\\",\\\"exit_code\\\":\\\"0:0\\\",\\\"elapsed_seconds\\\":8,\\\"allocated_CPUs\\\":1,\\\"TotalCPU_raw\\\":\\\"00:00:00\\\",\\\"node\\\":\\\"compute-0-11\\\",\\\"partition\\\":\\\"cpu\\\",\\\"start_CST\\\":\\\"2026-11-23T05:03:44\\\",\\\"end_CST\\\":\\\"2026-11-23T05:03:52\\\",\\\"workdir\\\":\\\"/\\\",\\\"scope_evidence\\\":[\\\"submission_path_D_recipe\\\"]}],\\\"scope_completion\\\":\\\"Original D submission paths plus explicitly registered own D job fields; excludes source_P and other-window drain records\\\",\\\"terminal_supplement_observation_window_UTC\\\":[\\\"2026-11-22T21:48:57Z\\\",\\\"2026-11-22T21:53:55Z\\\"]}\")\nterminal=[];live=[]\nfor raw in source[\"rows\"]:\n row=dict(raw)\n seconds=int(row[\"elapsed_seconds\"]);cpus=int(row[\"allocated_CPUs\"])\n row[\"allocated_CPU_hours\"]=seconds*cpus/3600\n row[\"parent_TotalCPU_seconds\"]=None\n row[\"parent_TotalCPU_available\"]=False\n row[\"parent_TotalCPU_reason\"]=\"Original parent TotalCPU is zero/unreported; not measured zero CPU use\"\n if row[\"TotalCPU_raw\"]!=\"00:00:00\":raise ValueError(\"Nonzero TotalCPU requires explicit parsing before publication\")\n node=row[\"node\"]\n gpu=node in [\"compute-0-\"+str(i) for i in list(range(8))+[20,22]]\n row[\"one_target_GPU_host_wall_hours_proxy\"]=seconds/3600 if gpu else 0.0\n row[\"GPU_count_source\"]=\"Own registered single-target GPU job; Slurm site does not allocate GPU GRES\" if gpu else None\n row[\"cost_is_partial_prefix\"]=row[\"state\"] in (\"RUNNING\",\"PENDING\",\"CONFIGURING\",\"COMPLETING\")\n (live if row[\"cost_is_partial_prefix\"] else terminal).append(row)\ndef totals(rows):\n return dict(parent_allocations=len(rows),elapsed_parent_hours=sum(x[\"elapsed_seconds\"] for x in rows)/3600,\n allocated_CPU_hours=sum(x[\"allocated_CPU_hours\"] for x in rows),\n one_target_GPU_host_wall_hours_proxy=sum(x[\"one_target_GPU_host_wall_hours_proxy\"] for x in rows))\nresult=dict(schema=\"D_WEEKLY_NATIVE_ALLOCATION_COSTS_V1\",as_of_UTC=source[\"observed_at_UTC\"],\n query_since_CST=source[\"query_since_CST\"],scope=source[\"scope\"],scope_completion=source[\"scope_completion\"],\n terminal_supplement_observation_window_UTC=source[\"terminal_supplement_observation_window_UTC\"],\n accounting_input_rows=len(source[\"rows\"]),allocation_only=True,raw_submit_commands_retained=False,\n includes_failures_and_cancelled_allocations=True,terminal=totals(terminal),active_partial_prefix=totals(live),\n terminal_status_counts=dict(collections.Counter(x[\"state\"] for x in terminal)),\n terminal_rows=terminal,active_partial_rows=live,producer_job_id=os.environ[\"SLURM_JOB_ID\"],\n producer_excluded_from_input_snapshot=True,\n producer_cost_policy=\"This short accounting producer starts after the input snapshot; append its native parent allocation separately after closure, without recomputing scientific results\",\n interpretation=dict(allocated_CPU_hours=\"ElapsedRaw times allocated CPUs; not CPU busy time\",\n GPU_host_proxy=\"Single-target GPU-host allocation wall, including embedded readout; not GPU busy time or billable GRES\",\n TotalCPU=\"All original parent TotalCPU fields are unreported zeros; measured TotalCPU unavailable\",\n concurrency=\"Parent elapsed hours sum overlapping allocations and are not calendar duration\",\n excludes=\"No batch/extern/progress-step double counting; no queue time; no new scientific metrics or telemetry reread\",\n monetary_cost=\"No verified rate: monetary cost unavailable\"),\n scientific_metrics_recomputed=False,old_telemetry_reread=False)\nroot=Path(\"/share/home/zixiao/descriptor_analysis/MFM_d_recipe\")\npublish_summary(root/\"results/d_recipe/costs_weekly_20261123.json\",result,c)\nt=result[\"terminal\"];a=result[\"active_partial_prefix\"]\ndoc=\"# D-family weekly native allocation costs\\n\\n\"\ndoc+=\"Snapshot: \"+result[\"as_of_UTC\"]+\"; Slurm query since \"+str(result[\"query_since_CST\"])+\" CST. This is the current cumulative week, not a completed-week claim.\\n\\n\"\ndoc+=\"| Scope | Parent allocations | Allocated CPU h | One-target GPU-host wall h |\\n|---|---:|---:|---:|\\n\"\nfor label,v in ((\"Terminal (including failed/cancelled)\",t),(\"Running prefix at snapshot\",a)):\n doc+=\"| %s | %d | %.9f | %.9f |\\n\"%(label,v[\"parent_allocations\"],v[\"allocated_CPU_hours\"],v[\"one_target_GPU_host_wall_hours_proxy\"])\ndoc+=\"\\nOriginal parent allocations only. Allocated CPU hours are ElapsedRaw × AllocCPUS; parent TotalCPU is unreported and remains unavailable. GPU-host wall is the registered single-target allocation proxy, not GPU busy time, device energy, or monetary cost. Embedded training/readout time is counted once. Batch, extern, observation steps and queue time are excluded.\\n\\n\"\ndoc+=\"Scope uses original D work/submission paths plus explicitly registered own D CURRENT job fields. Cancelled-before-start entries retain zero elapsed costs. Failed jobs retain real consumed allocation time. The two live A1 jobs are partial prefixes and will continue accruing cost. No telemetry or scientific arrays were reread.\\n\\n\"\ndoc+=\"[Per-job original accounting](../../results/d_recipe/costs_weekly_20261123.json) includes status, source provenance and original unreported TotalCPU values. The short accounting producer \"+os.environ[\"SLURM_JOB_ID\"]+\" begins after this input snapshot and is listed separately after closure. No monetary rate has been assumed.\\n\"\nfrom tools.d_recipe.resources import admit_output\ndestination=root/\"docs/d_recipe/COST.md\"\nadmit_output(c,destination.parent)\npending=destination.with_name(destination.name+\".partial\")\nwith pending.open(\"w\",encoding=\"utf-8\") as stream:\n stream.write(doc)\n stream.flush()\n os.fsync(stream.fileno())\nos.replace(pending,destination)\nprint(json.dumps(dict(phase=\"D_WEEKLY_COST_WRITTEN\",terminal=t,active_partial_prefix=a,status_counts=result[\"terminal_status_counts\"],producer_job=os.environ[\"SLURM_JOB_ID\"])),flush=True)\n'"]
_CHILD_ENV = {"PYTHONDONTWRITEBYTECODE":"1","PYTHONIOENCODING":"utf-8","PYTHONPATH":"/share/home/zixiao/descriptor_analysis/MFM_d_recipe:/share/home/zixiao/descriptor_analysis/MFM_d_recipe/current:/share/home/zixiao/descriptor_analysis/MFM_d_descriptors_20261120:/share/home/zixiao/descriptor_analysis/MFM_d_descriptors_20261120/current:/share/home/zixiao/descriptor_analysis/docs/phase1/evidence/stage61_data_input_audit_v1/scan_v2/deps","PATH":"/usr/bin:/bin:/usr/sbin:/sbin:/share/apps/softwares/anaconda3/bin:/share/apps/softwares/anaconda3/condabin:/share/home/zixiao/.local/bin:/share/home/zixiao/bin:/share/apps/bin:/usr/share/Modules/bin:/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/sbin:/share/apps/software/anaconda/bin:/share/apps/scripts:/share/apps/software/anaconda/bin:/share/apps/scripts","OMP_NUM_THREADS":"1","OPENBLAS_NUM_THREADS":"1","MKL_NUM_THREADS":"1","NUMEXPR_NUM_THREADS":"1"}
_ALLOWED_NODES = ["compute-0-11"]
_CLEANUP_SECONDS = 180
_ROOT_FUTURE_BYTES = 38788923392
_COOPERATIVE = False
import datetime
import json
import os
import re
import signal
import subprocess
import sys
import time
import types

_exit = types.ModuleType("d_resident_exit")
sys.modules[_exit.__name__] = _exit
exec(compile(_LIFECYCLE_SOURCE, "<resident-exit-lifecycle>", "exec"),
     _exit.__dict__)
_job = os.environ.get("SLURM_JOB_ID")
if not _job:
    raise RuntimeError("A real Slurm allocation is required")
_scope = _exit.slurm_scope(_job)
_exit.enable_subreaper()
_stop = {}
for _sig in (signal.SIGTERM, signal.SIGINT, signal.SIGUSR1):
    signal.signal(_sig, lambda received, frame: _stop.setdefault("signal", received))


def _query(arguments):
    process = subprocess.Popen(arguments, stdout=subprocess.PIPE,
                               stderr=subprocess.PIPE)
    bound = _exit.identity(process.pid)
    until = time.monotonic() + 10
    interrupted = False
    while True:
        try:
            out, error = process.communicate(timeout=.2)
            break
        except subprocess.TimeoutExpired:
            if _stop or time.monotonic() >= until:
                interrupted = True
                if bound is not None:
                    _exit.signal_owned(bound, signal.SIGTERM,
                                       uid=os.getuid(), scope=_scope)
                # Do not orphan or declare an unproven control query cleaned.
                try:
                    out, error = process.communicate(timeout=5)
                except subprocess.TimeoutExpired:
                    print(json.dumps(dict(phase="ADMIN_REQUIRED_RESIDENT_QUERY",
                                          pid=process.pid)), flush=True)
                    out, error = process.communicate()
                break
    if interrupted or process.returncode:
        raise RuntimeError("Resident Slurm query did not close normally: "
                           + error.decode("utf-8", "replace")[:500])
    return dict(re.findall(r"(\w+)=(\S+)", out.decode("utf-8", "replace")))


_record = _query(["/usr/bin/scontrol", "show", "job", _job, "-o"])
if (_record.get("JobId") != _job
        or _record.get("TimeLimit") in (None, "UNLIMITED", "NOT_SET", "N/A")
        or _record.get("EndTime") in (None, "Unknown", "N/A", "None")):
    raise RuntimeError("Actual finite allocation deadline must be known")
_end = datetime.datetime.fromisoformat(_record["EndTime"]).timestamp()
_node = os.uname().nodename.split(".")[0]
_health = _query(["/usr/bin/scontrol", "show", "node", _node, "-o"])
_state = _health.get("State", "").upper()
if (_health.get("NodeName") != _node or not _state
        or any(value in _state for value in
               ("DRAIN", "DOWN", "NOT_RESPOND", "NO_RESPOND", "UNKNOWN", "FAIL"))):
    raise RuntimeError("Actual node health is not admitted")
if _ALLOWED_NODES and _node not in _ALLOWED_NODES:
    raise RuntimeError("Actual node differs from the registered target")
_root = os.statvfs("/")
if os.stat("/tmp").st_dev != os.stat("/").st_dev:
    raise RuntimeError("Register a separate /tmp filesystem before this entry")
_system = max(10 * 2**30, (_root.f_blocks * _root.f_frsize + 9) // 10)
if (_root.f_bavail * _root.f_frsize < _system + _ROOT_FUTURE_BYTES
        or _root.f_favail < 10000):
    raise RuntimeError("Actual root reserve, future or inode allowance unavailable")
_exit.cleanup_seconds(_CLEANUP_SECONDS)
if _end - time.time() <= _CLEANUP_SECONDS:
    raise RuntimeError("No work may start in the cleanup window")
for _name, _value in _CHILD_ENV.items():
    os.environ[_name] = _value
os.environ["D_EXIT_OUTER_SUPERVISION"] = "1"
os.environ["D_RESIDENT_SUPERVISOR_PID"] = str(os.getpid())
os.environ["D_RESIDENT_SUPERVISOR_START_TICKS"] = str(
    _exit.identity(os.getpid()).start_ticks)
print(json.dumps(dict(phase="RESIDENT_BEFORE_SHARED_SOURCE", job_id=_job,
                      node=_node, TimeLimit=_record["TimeLimit"],
                      EndTime=_record["EndTime"],
                      root_available_bytes=_root.f_bavail * _root.f_frsize,
                      root_inodes=_root.f_favail,
                      source_independent=True)), flush=True)


def _cooperative_stop():
    # Only the direct managed child is asked to save/exit. A child still
    # loading shared Python code has no workers or committed training yet.
    for pid in _exit.children(os.getpid()):
        current = _exit.identity(pid)
        if current is not None:
            _exit.signal_owned(current, signal.SIGUSR1,
                               uid=os.getuid(), scope=_scope)


_result = _exit.supervise(
    _WORKER_COMMAND, end_epoch=_end, scope=_scope,
    grace_seconds=_CLEANUP_SECONDS, stop_state=_stop,
    request_stop=_cooperative_stop if _COOPERATIVE else None,
    report=lambda event: print(json.dumps(event), flush=True))
print(json.dumps(dict(phase="RESIDENT_TERMINAL", job_id=_job,
                      returncode=_result,
                      remaining_children=sorted(_exit.children(os.getpid())))),
      flush=True)
raise SystemExit(128 - _result if _result < 0 else _result)
