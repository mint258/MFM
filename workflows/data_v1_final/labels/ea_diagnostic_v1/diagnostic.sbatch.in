#!/bin/bash
#SBATCH --job-name=dv1_ea_diagnostic_v1
#SBATCH --partition=all
#SBATCH --nodelist=compute-0-20
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=01:00:00
#SBATCH --output=__LOG_PATH__
#SBATCH --chdir=/share/home/zixiao/descriptor_analysis
set -euo pipefail
export PYTHONDONTWRITEBYTECODE=1 CUDA_VISIBLE_DEVICES=""
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export PYTHONPATH=/share/home/zixiao/descriptor_analysis/runs/data_v1_20261025/repository:/share/home/zixiao/descriptor_analysis/docs/phase1/evidence/stage61_data_input_audit_v1/scan_v2/deps
srun --input=none --ntasks=1 --cpus-per-task=16 /share/home/zixiao/.conda/envs/chemprop/bin/python -B \
  __ROOT_BOUND_PROBE_PY__ --config __NEW_CONFIG_JSON__ --root-preflight __FRESH_INTENT_JSON__ \
  --output __NEW_EXTERNAL_OUTPUT__ </dev/null
