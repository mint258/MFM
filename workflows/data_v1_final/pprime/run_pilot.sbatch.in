#!/bin/bash
#SBATCH --job-name=@JOB_NAME@
#SBATCH --partition=cpu
#SBATCH --nodelist=@NODE@
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=02:00:00
#SBATCH --output=@LOG_PATH@
set -euo pipefail
case "${SLURMD_NODENAME}" in compute-0-1[4-9]) ;; *) exit 2 ;; esac
export CUDA_VISIBLE_DEVICES=""
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH=/share/home/zixiao/descriptor_analysis/docs/phase1/evidence/stage61_data_input_audit_v1/scan_v2/deps
exec /share/home/zixiao/.conda/envs/chemprop/bin/python @SOURCE_DIR@/run_pilot.py \
  --config @CONFIG@ --prepared @PREPARED@ --prepared-sha256 @PREPARED_SHA256@ \
  --output @OUTPUT@ --root-preflight @ROOT_PREFLIGHT@
