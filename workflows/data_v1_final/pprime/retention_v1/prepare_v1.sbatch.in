#!/bin/bash
#SBATCH --job-name=@NEW_JOB_NAME@
#SBATCH --partition=all
#SBATCH --nodelist=compute-0-20
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=02:00:00
#SBATCH --output=@NEW_LOG_PATH@
set -euo pipefail
export CUDA_VISIBLE_DEVICES="" PYTHONDONTWRITEBYTECODE=1
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export PYTHONPATH=/share/home/zixiao/descriptor_analysis/docs/phase1/evidence/stage61_data_input_audit_v1/scan_v2/deps
exec /share/home/zixiao/.conda/envs/chemprop/bin/python -B @SOURCE@/prepare_v1.py \
  --config @POLICY_CONFIG@ --original-prepared @ORIGINAL_PREPARED@ \
  --original-prepared-sha256 @ORIGINAL_PREPARED_SHA256@ \
  --root-preflight @NEW_ROOT_PREFLIGHT@ --output @NEW_OUTPUT@
