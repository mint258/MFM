cards={
"compute-0-5":("GPU-dac07d74-6269-c7db-8832-340dd3c0b377","gpu_cu118_job_4536985_step_24"),
"compute-0-7":("GPU-9db54192-dd3f-3177-e56f-dcd161ff932c","gpu_cu118_job_4536985_step_24"),
"compute-0-22":("GPU-9b6008d0-35dd-4bff-f69a-0927b04b7eef","gpu_cu128_job_4537025_step_5")}
out=b1/"C1_parallel_preparation"/("job_"+os.environ["SLURM_JOB_ID"])
safe();out.mkdir(parents=True)
prepared=[]
def program_reference(body):
    tree=ast.parse(body)
    matches=[node.value for node in ast.walk(tree) if isinstance(node,ast.Assign)
        and any(isinstance(target,ast.Name) and target.id=="PROGRAM" for target in node.targets)]
    if len(matches)!=1:raise ValueError("Expected one unchanged original neural source reference")
    return ast.dump(matches[0],include_attributes=False)
for index,model in enumerate(plan):
    if model["retain_original_job"]:continue
    target=model["target_node"];uuid,backend=cards[target]
    if target not in ("compute-0-5","compute-0-22"):raise ValueError("Only approved future target cards may replace a queue")
    source=sources[model["source_file"]]
    raw=source.split("<<'DOWNSTREAMGPU'\n",1)[1].rsplit("\nDOWNSTREAMGPU",1)[0]+"\n"
    original_body=raw.split("<<'PY'\n",1)[1].rsplit("\nPY",1)[0]
    rendered=raw.replace("compute-0-7",target).replace(model["uuid"],uuid)
    rendered=rendered.replace("gpu_cu118_job_4536985_step_24",backend)
    staged_body=rendered.split("<<'PY'\n",1)[1].rsplit("\nPY",1)[0]
    ast.parse(staged_body)
    if program_reference(original_body)!=program_reference(staged_body):
        raise ValueError("A routing update changed the original scientific program")
    if "#SBATCH --cpus-per-task=2" not in rendered or "#SBATCH --exclusive" in rendered:
        raise ValueError("Original demand-based two-CPU GPU request changed")
    python=b1/"environments"/backend/"tabpfn/bin/python"
    if not python.is_file() or not Path(model["program"]).is_file():
        raise ValueError("The original program or already-prepared compatible private backend is absent")
    path=out/("native_"+str(model["job"])+"_to_"+target+".sbatch")
    safe()
    with path.open("x") as stream:stream.write(rendered)
    prepared.append(dict(model,script=str(path),target_uuid=uuid,target_python=str(python),
        original_program_unchanged=True,original_model_seed=20261025,actual_GPU_fit_started=False))
report=dict(status="C1_PARALLEL_SOURCE_PREPARATION_CLOSED",job=os.environ["SLURM_JOB_ID"],node=socket.gethostname(),
    proposed_replacements=prepared,retained_original_jobs=[row["job"] for row in plan if row["retain_original_job"]],
    frozen_B1_roster_changed=False,original_MODEL_and_data_budget_changed=False,new_configurations_added=False,
    all_original_Pprime_feature_dependencies_retained=True,data_or_predictions_read=False,
    source_only=True,actual_GPU_fits_started=False)
safe();(out/"manifest.json").write_text(json.dumps(report,indent=2)+"\n")
print("C1_PARALLEL_SOURCES_PREPARED",out/"manifest.json","replacements",len(prepared),flush=True)

