ed_pending_zero_runtime\": true\n  },\n  \"active_source_count_handoff\": {\n    \"historical_domain_table_preserved\": true,\n    \"unit_tests_and_source_check_pending\": false,\n    \"native_state\": \"COMPLETED/0:0\",\n    \"job\": 4537016,\n    \"source_check_files\": 5265,\n    \"unit_tests_passed\": 3,\n    \"source_check_python_files\": 3736,\n    \"source_check_errors\": 0\n  },\n  \"active_domain_counts_csv\": \"/share/home/zixiao/descriptor_analysis/runs/data_v1_20261025/artifacts/benchmark_B0_20261119/delivery/directive19_current_counts_4537016/active_source_domain_counts.csv\",\n  \"historical_domain_counts_csv\": \"/share/home/zixiao/descriptor_analysis/runs/data_v1_20261025/artifacts/benchmark_B0_20261119/delivery/directive19_current_counts_4537016/domain_counts.csv\"\n}\n")
root=Path(entry['data_root']);b1=root.parent/'benchmark_B1_20261119'
quota=Path('/share/home/zixiao/descriptor_analysis/runs/data_v1_20261025/control/benchmark_B0_quota_20261119.json')
def safe():protect(root,2147483648,quota,own_concurrent_bytes=40*1024**3)
geometry_queue=root/'geometry/shared_v1/queue.sqlite'
pprime_queue=root/'labels/Pprime/shared_v1/queue.sqlite'
for queue in (geometry_queue,pprime_queue):
    declaration=check_access(queue)
    if not declaration or not declaration.get('immutable') or not declaration.get('cross_node_read_allowed'):
        raise RuntimeError('Corresponding original native Pprime/Sprime must be sealed before consuming the shared database')
schema_path=Path('/lfshome/zixiao/data_v1_20261025/D3_v31_pilot_20261105_v1/schema.json')
pretraining=json.loads(schema_path.read_text())
wp5_wire_path=Path('/share/home/zixiao/descriptor_analysis/runs/phase1_wp5_20261011/scripts/wp5_parquet_v2.py')
spec=importlib.util.spec_from_file_location('_original_pretraining_wp5_wire',wp5_wire_path)
wire=importlib.util.module_from_spec(spec);spec.loader.exec_module(wire)
def lookup(detail,path):
    value=wire.lookup(detail,path)
    return MISSING if value is wire.MISSING else wire.native(value)
layout=NativePprimeLayout(pretraining,lookup)
D_root=b1/'C1_D_features/job_4536892';source=json.loads((D_root/'manifest.json').read_text())
proof=json.loads(Path(source['full_inventory_scope_proof']).read_text())
assert proof['deferred_registry_full_inventory_verified'] is True and proof['deferred_endpoint_count']==5
safe();out=b1/'C1_Pprime_features'/('job_'+os.environ['SLURM_JOB_ID']);out.mkdir(parents=True)
groups=('Pprime','Pprime_plus_D')
for name in groups:(out/name).mkdir()
(out/'B0.DELIVERY.json').write_text(json.dumps(entry,indent=2)+'\n')
feature_names=dict(Pprime=[c['field_key'] for c in layout.molecule],Pprime_plus_D=[c['field_key'] for c in layout.molecule]+source['feature_names'])
summaries={name:[] for name in groups};cache=OrderedDict()
with SharedB0Reader(geometry_queue) as geometry,PprimeReader(pprime_queue) as quantum:
    for source_group in source['source_groups']:
        group=source_group['dataset'];path=Path(source_group['features']);parquet=pq.ParquetFile(path)
        counts={name:Counter() for name in groups};schema=parquet.schema_arrow
        target_paths={name:out/name/(group+'.parquet') for name in groups}
        with pq.ParquetWriter(target_paths['Pprime'],schema,compression='zstd') as only_writer,pq.ParquetWriter(target_paths['Pprime_plus_D'],schema,compression='zstd') as combined_writer:
            for batch in parquet.iter_batches(batch_size=128):
                buffers={name:[] for name in groups}
                for row in batch.to_pylist():
                    vector=None;state='OUTSIDE_DOMAIN_NO_C1_PPRIME'
                    if row['retained'] and row['domain_eligible']:
                        native=geometry.get(group,row['record_id']);cid=first_actual_conformer(native)
                        state=native['state']
                        if cid is not None:
                            key=(native['shared_molecule_id'],cid)
                            if key in cache:vector,state=cache.pop(key)
                            else:
                                result=quantum.get(key[0],cid);state=result['state']
                                molecular,_,detail=layout.extract(result,len(native['result']['atomic_numbers']))
                                vector=molecular.tolist() if molecular is not None and np.isfinite(molecular).any() else None
                            cache[key]=(vector,state)
                            while len(cache)>2048:cache.popitem(last=False)
                    for name in groups:
                        values=vector
                        if name=='Pprime_plus_D':
                            values=vector+row['features'] if vector is not None and row['features'] is not None and any(row['valid_mask'] or []) else None
                        cooked=dict(row,features=values,valid_mask=None if values is None else [math.isfinite(v) for v in values],feature_state='NATIVE_'+name+'_'+state)
                        buffers[name].append(cooked);counts[name]['source_rows']+=1
                        counts[name]['native_features_available' if values is not None else 'native_features_unavailable']+=1
                safe();only_writer.write_table(pa.Table.from_pylist(buffers['Pprime'],schema=schema));combined_writer.write_table(pa.Table.from_pylist(buffers['Pprime_plus_D'],schema=schema))
        for name in groups:summaries[name].append(dict(dataset=group,features=str(target_paths[name]),counts=dict(counts[name])))
        print('C1_PPRIME_SOURCE_GROUP_CLOSED',group,{name:dict(counts[name]) for name in groups},flush=True)
for name in groups:
    report=dict(status='C1_NATIVE_'+name.upper()+'_FEATURES_CLOSED',job=os.environ['SLURM_JOB_ID'],source_entry=str(out/'B0.DELIVERY.json'),full_inventory_scope_proof=source['full_inventory_scope_proof'],source_groups=summaries[name],feature_names=feature_names[name],pretraining_schema=str(schema_path),native_WP5_field_lookup=str(wp5_wire_path),original_component_reader='workflows.data_v1_final.labels.common.component_values',geometry='First actual accepted shared UFF conformer ID, without later success selection',native_Pprime_source=str(pprime_queue),native_D_source=str(D_root/'manifest.json'),C1_feature_group=name,reference_group_bindings_pending=['C7H10O2','PPE1694','NMRShiftDB2'],normalization_fitted=False,source_masks_and_units_unchanged=True,missing_calculations_not_imputed=True,independent_numeric_readback=False,model_fits_run=False)
    safe();(out/name/'manifest.json').write_text(json.dumps(report,indent=2)+'\n')
report=dict(status='C1_PPRIME_AND_PPRIME_PLUS_D_EIGHT_TABULAR_GROUPS_CLOSED',job=os.environ['SLURM_JOB_ID'],source_entry=str(out/'B0.DELIVERY.json'),feature_groups={name:str(out/name/'manifest.json') for name in groups},Pprime_label=True,P_label=False,model_fits_run=False,source_quantum_and_geometry_not_recomputed=True,no_database_copy=True,independent_numeric_readback=False)
safe();(out/'manifest.json').write_text(json.dumps(report,indent=2)+'\n')
print('C1_PPRIME_SHARED_FEATURE_SOURCE_CLOSED',out/'manifest.json',flush=True)

