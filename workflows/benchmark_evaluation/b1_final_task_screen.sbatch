sbatch <<'B1FINALSCREEN'
#!/bin/bash
#SBATCH --job-name=B1-final-single-task-screen
#SBATCH --partition=cpu
#SBATCH --exclude=compute-0-2,compute-0-18,compute-0-21
#SBATCH --cpus-per-task=2
#SBATCH --ntasks=1
#SBATCH --nodes=1
#SBATCH --time=01:00:00
#SBATCH --output=/share/home/zixiao/descriptor_analysis/runs/data_v1_20261025/control/B1_final_task_screen_%j.log
set -euo pipefail
repo=/share/home/zixiao/descriptor_analysis/runs/data_v1_20261025/worktrees/benchmark_b1_20261119
export PYTHONPATH="$repo:/share/home/zixiao/descriptor_analysis/runs/data_v1_20261025/artifacts/benchmark_B0_20261119/runtime_deps:/share/home/zixiao/descriptor_analysis/docs/phase1/evidence/stage61_data_input_audit_v1/scan_v2/deps"
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 CUDA_VISIBLE_DEVICES='' PYTHONDONTWRITEBYTECODE=1
cd "$repo"
findmnt -T "$repo"
df -B1 "$repo" /tmp
df -Pi "$repo" /tmp
/share/home/zixiao/.conda/envs/chemprop/bin/python -B - <<'PY'
import sys,types
package=types.ModuleType('workflows.benchmark_evaluation');package.__path__=[];sys.modules[package.__name__]=package
for name,source in [["selection","\"\"\"Pre-registered B1 decisions and scaffold folds; no fitting or result selection.\"\"\"\nfrom itertools import combinations\nimport math\nimport numpy as np\n\nBASELINES = (\"RF-ECFP4\", \"LightGBM-RDKit2D\", \"Chemprop-v2\")\nSEED = 20261025\n\nclass IncompleteComparison(ValueError):\n    \"\"\"A comparison cannot be made on unaligned or incomplete predictions.\"\"\"\n\ndef align_predictions(predictions):\n    \"\"\"Require identical IDs, original labels, molecular groups, and references.\"\"\"\n    if set(predictions) != set(BASELINES):\n        raise IncompleteComparison(\"All three pre-registered B1 baselines are required\")\n    indexed = {}\n    for name in BASELINES:\n        rows = predictions[name]\n        if any(row[\"evaluation_id\"] is None or not str(row[\"evaluation_id\"]).strip()\n               or not row[\"full_inchikey\"] for row in rows):\n            raise IncompleteComparison(\"Missing evaluation or complete molecule identity\")\n        mapping = {str(row[\"evaluation_id\"]): row for row in rows}\n        if not mapping or len(mapping) != len(rows):\n            raise IncompleteComparison(\"Missing or duplicate evaluation IDs\")\n        indexed[name] = mapping\n    ids = sorted(indexed[BASELINES[0]])\n    first = indexed[BASELINES[0]]\n    y = np.asarray([first[key][\"y_true\"] for key in ids], dtype=float)\n    means = np.asarray([first[key][\"training_mean\"] for key in ids], dtype=float)\n    groups = np.asarray([str(first[key][\"full_inchikey\"]) for key in ids])\n    values = []\n    if not np.isfinite(y).all() or not np.isfinite(means).all():\n        raise IncompleteComparison(\"Nonfinite labels or TRAIN means\")\n    if any(not str(first[key][\"full_inchikey\"]) for key in ids):\n        raise IncompleteComparison(\"Missing complete molecular identity\")\n    for name in BASELINES:\n        mapping = indexed[name]\n        if set(mapping) != set(ids):\n            raise IncompleteComparison(\"Evaluation populations differ; do not intersect them\")\n        other_y = np.asarray([mapping[key][\"y_true\"] for key in ids], dtype=float)\n        other_means = np.asarray([mapping[key][\"training_mean\"] for key in ids], dtype=float)\n        other_groups = np.asarray([str(mapping[key][\"full_inchikey\"]) for key in ids])\n        if not (np.array_equal(y, other_y) and np.array_equal(means, other_means)\n                and np.array_equal(groups, other_groups)):\n            raise IncompleteComparison(\"Labels, TRAIN references, or molecule groups differ\")\n        prediction = np.asarray([mapping[key][\"prediction\"] for key in ids], dtype=float)\n        if not np.isfinite(prediction).all():\n            raise IncompleteComparison(\"Missing predictions must not redefine the test population\")\n        values.append(prediction)\n    return ids, y, means, groups, np.asarray(values)\n\ndef paired_bootstrap(predictions, draws=1000, seed=SEED):\n    \"\"\"Resample whole molecules identically across the three baseline predictions.\"\"\"\n    if draws != 1000:\n        raise ValueError(\"The registered B1 protocol requires 1000 draws\")\n    ids, y, means, groups, values = align_predictions(predictions)\n    unique, inverse = np.unique(groups, return_inverse=True)\n    error = np.asarray([\n        np.bincount(inverse, weights=np.abs(y - value), minlength=len(unique))\n        for value in values\n    ])\n    reference = np.bincount(inverse, weights=np.abs(y - means), minlength=len(unique))\n    denominator = float(reference.sum())\n    if denominator <= 0:\n        raise IncompleteComparison(\"TRAIN-mean reference has zero error\")\n    rae = error.sum(axis=1) / denominator\n    bootstrap = np.empty((draws, len(BASELINES)), dtype=float)\n    rng = np.random.default_rng(seed)\n    for index in range(draws):\n        sample = rng.integers(0, len(unique), size=len(unique))\n        divisor = float(reference[sample].sum())\n        if divisor <= 0:\n            raise IncompleteComparison(\"A molecule-bootstrap draw has zero reference error\")\n        bootstrap[index] = error[:, sample].sum(axis=1) / divisor\n    best_index = int(np.argmin(rae))\n    worst_index = int(np.argmax(rae))\n    paired_range = bootstrap[:, worst_index] - bootstrap[:, best_index]\n    standard_error = float(paired_range.std(ddof=1))\n    return {\n        \"baseline_order\": list(BASELINES),\n        \"RAE\": rae.tolist(),\n        \"RAE_CI95_low\": np.quantile(bootstrap, .025, axis=0).tolist(),\n        \"RAE_CI95_high\": np.quantile(bootstrap, .975, axis=0).tolist(),\n        \"best_baseline\": BASELINES[best_index],\n        \"best_index\": best_index,\n        \"worst_baseline\": BASELINES[worst_index],\n        \"RAE_range\": float(rae[worst_index] - rae[best_index]),\n        \"paired_best_worst_bootstrap_SE\": standard_error,\n        \"discrimination_threshold\": max(.02, 2 * standard_error),\n        \"molecule_bootstrap_draws\": draws,\n        \"n_test_rows\": len(ids),\n        \"n_test_molecules\": len(unique),\n    }\n\ndef decide_endpoint(predictions, *, n_filtered_labeled_points, scope_proof):\n    \"\"\"Apply the task rule once, after completeness; never use C1 or our models.\"\"\"\n    if (scope_proof.get(\"deferred_registry_full_inventory_verified\") is not True\n            or scope_proof.get(\"deferred_endpoint_count\") != 5):\n        raise IncompleteComparison(\"The complete five-endpoint scope proof is required\")\n    if not isinstance(n_filtered_labeled_points, int) or n_filtered_labeled_points < 0:\n        raise ValueError(\"Provide the whole filtered endpoint's labeled point count\")\n    result = paired_bootstrap(predictions)\n    best = result[\"best_index\"]\n    if n_filtered_labeled_points < 30:\n        decision, reason = \"APPENDIX\", \"FEWER_THAN_30_FILTERED_LABELED_POINTS\"\n    elif result[\"RAE\"][best] >= .90 and result[\"RAE_CI95_high\"][best] >= .85:\n        decision, reason = \"EXCLUDE\", \"INSUFFICIENT_SIGNAL\"\n    elif result[\"RAE_range\"] < result[\"discrimination_threshold\"]:\n        decision, reason = \"APPENDIX\", \"INSUFFICIENT_DISCRIMINATION\"\n    else:\n        decision, reason = \"RETAIN\", \"PASSED_REGISTERED_B1_RULE\"\n    return dict(result, decision=decision, reason=reason,\n                n_filtered_labeled_points=n_filtered_labeled_points)\n\ndef scaffold_folds(scaffold_groups, seed=SEED):\n    \"\"\"Yield five repetitions of five disjoint scaffold-group folds.\"\"\"\n    groups = np.asarray(scaffold_groups, dtype=str)\n    unique, inverse = np.unique(groups, return_inverse=True)\n    if len(unique) < 5:\n        raise IncompleteComparison(\"Fewer than five scaffolds; do not replace with a random split\")\n    members = [np.flatnonzero(inverse == index) for index in range(len(unique))]\n    streams = np.random.SeedSequence(seed).spawn(5)\n    for repetition, stream in enumerate(streams):\n        rng = np.random.default_rng(stream)\n        order = rng.permutation(len(unique))\n        assignments = [[] for _ in range(5)]\n        sizes = np.zeros(5, dtype=int)\n        for index in order:\n            candidates = np.flatnonzero(sizes == sizes.min())\n            fold = int(rng.choice(candidates))\n            assignments[fold].extend(members[index].tolist())\n            sizes[fold] += len(members[index])\n        for fold, selected in enumerate(assignments):\n            test = np.sort(np.asarray(selected, dtype=int))\n            train = np.setdiff1d(np.arange(len(groups)), test)\n            if not len(train) or not len(test):\n                raise IncompleteComparison(\"Empty scaffold fold; no split substitution allowed\")\n            yield repetition, fold, train, test\n\ndef tukey_cv(fold_scores):\n    \"\"\"Use the registered 25 scaffold-fold scores for Tukey HSD comparisons.\"\"\"\n    from scipy.stats import tukey_hsd\n    required = {(repetition, fold) for repetition in range(5) for fold in range(5)}\n    if set(fold_scores) != set(BASELINES):\n        raise IncompleteComparison(\"All three baselines are required for Tukey HSD\")\n    samples = []\n    for name in BASELINES:\n        rows = fold_scores[name]\n        if len(rows) != 25 or set(rows) != required:\n            raise IncompleteComparison(\"Each model needs the same 25 scaffold folds\")\n        values = np.asarray([rows[key] for key in sorted(required)], dtype=float)\n        if not np.isfinite(values).all():\n            raise IncompleteComparison(\"Missing fold scores cannot be discarded\")\n        samples.append(values)\n    comparison = tukey_hsd(*samples)\n    return [\n        {\"left\": BASELINES[left], \"right\": BASELINES[right],\n         \"mean_RAE_difference\": float(comparison.statistic[left, right]),\n         \"pvalue\": float(comparison.pvalue[left, right])}\n        for left, right in combinations(range(len(BASELINES)), 2)\n    ]\n"],["reporting","\"\"\"Bind closed B1 producer outputs for the single registered task-screen consumer.\n\nThis module reads predictions for reporting and new paired statistics. It does not\nrefit models, rerun producer scores, change populations, or use C1 for decisions.\n\"\"\"\nfrom collections import defaultdict\nfrom pathlib import Path\nimport json\nimport math\nimport numpy as np\nfrom workflows.benchmark_data.task_selection import canonical_task_key\nfrom .selection import BASELINES, IncompleteComparison, align_predictions, decide_endpoint, tukey_cv\n\nCV_DATASETS = frozenset((\"C7H10O2\", \"PPE1694\", \"Joung2020\"))\nBLIND_DATASETS = frozenset((\"ExpansionRx\", \"ASAP_Polaris2025\"))\nAPPENDIX_DATASETS = frozenset((\"Biogen_ADME\", \"TDC_ADMET\"))\nFOLDS = frozenset((r, f) for r in range(5) for f in range(5))\n\ndef resolve_endpoint(catalog, dataset, task):\n    \"\"\"Resolve original source task names against the frozen active catalog.\"\"\"\n    if dataset in (\"MoleculeACE\", \"PharmaBench\", \"TDC_ADMET\"):\n        target = {\"MoleculeACE\": \"y\", \"PharmaBench\": \"value\", \"TDC_ADMET\": \"Y\"}[dataset]\n        expected = canonical_task_key(dataset, task) + \"::\" + target\n        matches = [r for r in catalog if r[\"dataset\"] == dataset and r[\"endpoint_key\"] == expected]\n    else:\n        matches = [r for r in catalog if r[\"dataset\"] == dataset and r[\"target\"] == task]\n    if len(matches) != 1:\n        raise IncompleteComparison(\"Producer task does not match exactly one active catalog endpoint: \" + repr((dataset, task)))\n    return matches[0][\"endpoint_key\"]\n\ndef normalize_prediction(row, catalog):\n    if row[\"model\"] not in BASELINES:\n        raise IncompleteComparison(\"C1 or an unregistered model cannot enter the B1 screen\")\n    answer = dict(row)\n    answer[\"endpoint_key\"] = resolve_endpoint(catalog, row[\"dataset\"], row[\"task\"])\n    answer[\"evaluation_id\"] = str(row[\"record_id\"])\n    answer[\"eligible\"] = bool(row[\"retained\"] and row[\"domain_eligible\"])\n    if row[\"dataset\"] in CV_DATASETS:\n        rep, fold = row.get(\"repetition\"), row.get(\"fold\")\n        if (rep, fold) not in FOLDS:\n            raise IncompleteComparison(\"CV prediction lacks its original repetition/fold\")\n        expected_suffix = \"::repeat:\" + str(rep)\n        if not answer[\"evaluation_id\"].endswith(expected_suffix):\n            raise IncompleteComparison(\"Repeated CV prediction lost its original repetition identity\")\n    return answer\n\ndef primary_rows(dataset, rows):\n    chosen = [r for r in rows if r[\"fit_population\"] == \"retained\"]\n    if dataset not in BLIND_DATASETS and any(not r[\"eligible\"] for r in chosen):\n        raise IncompleteComparison(\"An ineligible row entered the registered retained fit\")\n    if dataset in BLIND_DATASETS:\n        for row in chosen:\n            if not row[\"eligible\"] and row[\"prediction\"] != row[\"training_mean\"]:\n                raise IncompleteComparison(\"A blind outside-domain point lacks the fixed TRAIN-mean fallback\")\n    return chosen\n\ndef fold_presence(rows):\n    \"\"\"Require all 25 original folds; never discard a failed or empty fold.\"\"\"\n    observed = {(r.get(\"repetition\"), r.get(\"fold\")) for r in rows}\n    if observed != FOLDS:\n        raise IncompleteComparison(\"The repeated-scaffold comparison does not contain every registered fold\")\n\ndef diagnostic_metrics(rows):\n    \"\"\"New final report metrics; empty subsets remain explicit.\"\"\"\n    if not rows:\n        return {\"status\": \"EMPTY_EVALUATION_POPULATION\", \"n_test_rows\": 0}\n    y = np.asarray([r[\"y_true\"] for r in rows], float)\n    p = np.asarray([r[\"prediction\"] for r in rows], float)\n    reference = np.asarray([r[\"training_mean\"] for r in rows], float)\n    if not (np.isfinite(y).all() and np.isfinite(p).all() and np.isfinite(reference).all()):\n        raise IncompleteComparison(\"Nonfinite predictions cannot shrink a reporting population\")\n    denominator = np.abs(y-reference).sum()\n    return {\"status\": \"REPORTED\", \"n_test_rows\": len(rows),\n            \"n_test_molecules\": len({r[\"full_inchikey\"] for r in rows}),\n            \"MAE\": float(np.abs(y-p).mean()),\n            \"RAE\": float(np.abs(y-p).sum()/denominator) if denominator > 0 else None}\n\ndef fold_rae(rows):\n    by_fold = defaultdict(list)\n    fold_presence(rows)\n    for row in rows:\n        by_fold[(row[\"repetition\"], row[\"fold\"])].append(row)\n    result = {}\n    for key, values in by_fold.items():\n        score = diagnostic_metrics(values)[\"RAE\"]\n        if score is None:\n            raise IncompleteComparison(\"A registered scaffold fold has zero TRAIN-reference error\")\n        result[key] = score\n    return result\n\ndef filtered_labeled_count(coverage):\n    \"\"\"Use producer counts after original finite labels/atom bindings, not source row totals.\"\"\"\n    if \"filtered_total_labeled_points\" in coverage:\n        value = coverage[\"filtered_total_labeled_points\"]\n    elif \"filtered_labeled_feature_available_points\" in coverage:\n        value = coverage[\"filtered_labeled_feature_available_points\"]\n    elif \"eligible_train\" in coverage and \"eligible_test\" in coverage:\n        value = coverage[\"eligible_train\"] + coverage[\"eligible_test\"]\n    elif \"retained_train_atomic_points\" in coverage and \"retained_test_atomic_points\" in coverage:\n        value = coverage[\"retained_train_atomic_points\"] + coverage[\"retained_test_atomic_points\"]\n    else:\n        raise IncompleteComparison(\"Producer does not supply a finite-label filtered point count\")\n    if isinstance(value, bool) or not isinstance(value, int) or value < 0:\n        raise IncompleteComparison(\"Invalid original filtered labeled point count\")\n    return value\n\ndef close_endpoint(candidate, predictions, n_filtered_labeled_points, scope_proof):\n    \"\"\"Produce one decision only after the three full primary populations align.\"\"\"\n    dataset = candidate[\"dataset\"]\n    primary = {name: primary_rows(dataset, predictions[name]) for name in BASELINES}\n    full = {name: [r for r in predictions[name] if r[\"fit_population\"] == \"full\"] for name in BASELINES}\n    align_predictions(full)\n    tukey = []\n    if dataset in CV_DATASETS:\n        for rows in full.values():\n            fold_presence(rows)\n        for rows in primary.values():\n            fold_presence(rows)\n        tukey = tukey_cv({name: fold_rae(rows) for name, rows in primary.items()})\n    decision = decide_endpoint(primary, n_filtered_labeled_points=n_filtered_labeled_points,\n                               scope_proof=scope_proof)\n    decision[\"registered_rule_decision\"] = decision[\"decision\"]\n    if dataset in APPENDIX_DATASETS and decision[\"decision\"] == \"RETAIN\":\n        decision[\"decision\"] = \"APPENDIX\"\n        decision[\"reason\"] = \"PRE_REGISTERED_APPENDIX_ROLE_PRESERVED\"\n    diagnostics = []\n    for name in BASELINES:\n        rows = predictions[name]\n        full = [r for r in rows if r[\"fit_population\"] == \"full\"]\n        for fit, population, selected in (\n            (\"retained\", \"blind_full\" if dataset in BLIND_DATASETS else \"retained\", primary[name]),\n            (\"full\", \"full\", full),\n            (\"full\", \"retained\", [r for r in full if r[\"eligible\"]]),\n            (\"full\", \"excluded\", [r for r in full if not r[\"eligible\"]]),\n        ):\n            diagnostics.append(dict(model=name, fit_population=fit, evaluation_population=population,\n                                    **diagnostic_metrics(selected)))\n    return decision, diagnostics, tukey\n\nclass ClosedPredictionConsumer:\n    \"\"\"Read each source file once, after native producer accounting is terminal.\"\"\"\n    def __init__(self, catalog):\n        self.catalog = catalog\n        self.seen_paths = set()\n        self.predictions = defaultdict(lambda: defaultdict(list))\n        self.coverage = defaultdict(list)\n        self.failures = defaultdict(list)\n        self.sources = []\n\n    def add_run(self, folder, native_state, expected_model=None, array_job=None):\n        import pyarrow.parquet as pq\n        folder = Path(folder)\n        if native_state not in {\"COMPLETED\", \"FAILED\", \"CANCELLED\", \"TIMEOUT\", \"OUT_OF_MEMORY\", \"NODE_FAIL\", \"BOOT_FAIL\", \"PREEMPTED\", \"DEADLINE\"}:\n            raise IncompleteComparison(\"Final reporting cannot read a live or pending producer\")\n        manifest_path = folder / \"manifest.json\"\n        if not manifest_path.is_file():\n            self.sources.append({\"folder\": str(folder), \"native_state\": native_state,\n                                 \"status\": \"UNRESOLVED_NO_CLOSED_PRODUCER_MANIFEST\"})\n            return\n        manifest = json.loads(manifest_path.read_text())\n        if array_job is not None and str(manifest.get(\"array_job\")) != str(array_job):\n            raise IncompleteComparison(\"Array artifact does not name the declared native parent\")\n        self.sources.append({\"folder\": str(folder), \"native_state\": native_state,\n                             \"producer_job\": manifest.get(\"job\"), \"status\": manifest.get(\"status\"),\n                             \"array_job\": manifest.get(\"array_job\"), \"array_index\": manifest.get(\"array_index\")})\n        for record in manifest.get(\"coverage\", []):\n            if \"dataset\" in record and \"task\" in record:\n                endpoint = resolve_endpoint(self.catalog, record[\"dataset\"], record[\"task\"])\n                self.coverage[endpoint].append(record)\n        for failure in manifest.get(\"failures\", []):\n            if failure.get(\"dataset\") and failure.get(\"task\"):\n                endpoint = resolve_endpoint(self.catalog, failure[\"dataset\"], failure[\"task\"])\n                self.failures[endpoint].append(failure)\n        for path in sorted(folder.rglob(\"*predictions.parquet\")):\n            if path in self.seen_paths:\n                raise IncompleteComparison(\"A prediction artifact has been scheduled twice\")\n            self.seen_paths.add(path)\n            for batch in pq.ParquetFile(path).iter_batches(batch_size=4096):\n                for raw in batch.to_pylist():\n                    if expected_model is not None and raw[\"model\"] != expected_model:\n                        raise IncompleteComparison(\"Producer model differs from its native job binding\")\n                    row = normalize_prediction(raw, self.catalog)\n                    self.predictions[row[\"endpoint_key\"]][row[\"model\"]].append(row)\n\n    def screen_once(self, scope_proof, unresolved=None):\n        unresolved = {} if unresolved is None else dict(unresolved)\n        screen, diagnostics, tukey = [], [], []\n        if len(self.catalog) != 96 or len({r[\"endpoint_key\"] for r in self.catalog}) != 96:\n            raise IncompleteComparison(\"Expected the complete frozen 96-endpoint active catalog\")\n        for candidate in self.catalog:\n            key = candidate[\"endpoint_key\"]\n            base = {name: candidate[name] for name in (\"endpoint_key\", \"dataset\", \"target\", \"level\", \"split_policy\")}\n            if candidate[\"dataset\"] == \"pKahub\" and candidate[\"target\"] == \"single_site_mechanism\":\n                screen.append(dict(base, status=\"UNRESOLVED\", decision=\"UNRESOLVED\",\n                                   reason=\"ORIGINAL_EXPERIMENTAL_SINGLE_SITE_ATOM_ANNOTATIONS_ABSENT\",\n                                   single_site_molecule_count=\"UNKNOWN\", multi_site_molecule_count=\"UNKNOWN\"))\n                continue\n            try:\n                predictions = self.predictions[key]\n                if set(predictions) != set(BASELINES):\n                    raise IncompleteComparison(\"One or more registered baseline results are unfinished\")\n                counts = {filtered_labeled_count(row) for row in self.coverage[key]\n                          if any(name in row for name in (\"filtered_total_labeled_points\",\n                              \"filtered_labeled_feature_available_points\", \"eligible_train\", \"retained_train_atomic_points\"))}\n                if len(counts) != 1:\n                    raise IncompleteComparison(\"Missing or inconsistent finite-label filtered point counts\")\n                decision, impact, comparisons = close_endpoint(candidate, predictions, counts.pop(), scope_proof)\n                record = dict(base, status=\"SCREENED\", **{k:v for k,v in decision.items()\n                    if k not in (\"RAE\", \"RAE_CI95_low\", \"RAE_CI95_high\", \"baseline_order\")})\n                for index, name in enumerate(BASELINES):\n                    for field in (\"RAE\", \"RAE_CI95_low\", \"RAE_CI95_high\"):\n                        record[name+\"_\"+field] = decision[field][index]\n                screen.append(record)\n                diagnostics.extend(dict(base, **row) for row in impact)\n                tukey.extend(dict(base, **row) for row in comparisons)\n            except IncompleteComparison as error:\n                if key not in unresolved:\n                    raise IncompleteComparison(key + \": \" + str(error)) from error\n                screen.append(dict(base, status=\"UNRESOLVED\", decision=\"UNRESOLVED\",\n                                   reason=unresolved[key], producer_failures=json.dumps(self.failures[key], sort_keys=True)))\n        return screen, diagnostics, tukey\n\ndef resolve_array_run(manifests, parent_job, array_index):\n    \"\"\"Use actual producer array metadata, independent of sacct RawJobID formatting.\"\"\"\n    matches=[(folder,record) for folder,record in manifests\n             if str(record.get(\"array_job\"))==str(parent_job)\n             and str(record.get(\"array_index\"))==str(array_index)]\n    if len(matches)!=1:\n        raise IncompleteComparison(\"Expected one closed producer manifest for the native array element\")\n    folder,record=matches[0]\n    if Path(folder).name!=\"job_\"+str(record.get(\"job\")):\n        raise IncompleteComparison(\"Array producer folder differs from its actual SLURM_JOB_ID\")\n    return Path(folder)\n"],["comparisons","\"\"\"Paired final comparisons and the user's conditional second-seed policy.\n\nThese are new reporting statistics on original closed predictions. They never\nchange B1 membership, labels, original CV folds, or model hyperparameters.\n\"\"\"\nimport math\nimport numpy as np\nfrom .selection import IncompleteComparison, SEED\n\nFOLDS = frozenset((r, f) for r in range(5) for f in range(5))\n\ndef index_predictions(rows, allow_native_missing=False):\n    mapping = {}\n    for row in rows:\n        identity = row.get(\"evaluation_id\", row.get(\"record_id\"))\n        if identity is None or not str(identity).strip() or not row.get(\"full_inchikey\"):\n            raise IncompleteComparison(\"Original evaluation ID and full molecular identity are required\")\n        identity = str(identity)\n        if identity in mapping:\n            raise IncompleteComparison(\"Duplicate original evaluation ID\")\n        value = row.get(\"prediction\")\n        if value is None:\n            if not allow_native_missing:\n                raise IncompleteComparison(\"A missing prediction cannot shrink an ordinary comparison\")\n        elif not math.isfinite(float(value)):\n            raise IncompleteComparison(\"A nonfinite model prediction is not an availability declaration\")\n        if not (math.isfinite(float(row[\"y_true\"])) and math.isfinite(float(row[\"training_mean\"]))):\n            raise IncompleteComparison(\"Original labels and fit TRAIN means must be finite\")\n        mapping[identity] = row\n    if not mapping:\n        raise IncompleteComparison(\"No predictions are available\")\n    return mapping\n\ndef paired_improvement(reference, candidate, *, allow_native_missing=False, scaffold_cv=False):\n    \"\"\"Use a declared common native-feature population only for C1 missingness.\n\n    Every molecular bootstrap draw is paired across methods. Each method keeps\n    its actual original TRAIN-mean reference. CV significance uses Tukey HSD on\n    all25 original fold scores; official-split significance uses the paired\n    RAE-improvement95% interval. Pooled RAE is also reported for transparency.\n    \"\"\"\n    ref = index_predictions(reference, allow_native_missing)\n    cand = index_predictions(candidate, allow_native_missing)\n    if not allow_native_missing and set(ref) != set(cand):\n        raise IncompleteComparison(\"Ordinary comparison populations differ\")\n    shared = sorted(set(ref) & set(cand))\n    for identity in shared:\n        left, right = ref[identity], cand[identity]\n        if left[\"y_true\"] != right[\"y_true\"] or left[\"full_inchikey\"] != right[\"full_inchikey\"]:\n            raise IncompleteComparison(\"Original labels or molecular groups differ\")\n        if scaffold_cv and (left.get(\"repetition\"), left.get(\"fold\")) != (right.get(\"repetition\"), right.get(\"fold\")):\n            raise IncompleteComparison(\"Original CV fold membership differs\")\n    ids = [identity for identity in shared\n           if ref[identity][\"prediction\"] is not None and cand[identity][\"prediction\"] is not None]\n    if not ids:\n        raise IncompleteComparison(\"No common native-feature predictions are available\")\n    y = np.asarray([ref[key][\"y_true\"] for key in ids], float)\n    p = np.asarray([[side[key][\"prediction\"] for key in ids] for side in (ref,cand)], float)\n    means = np.asarray([[side[key][\"training_mean\"] for key in ids] for side in (ref,cand)], float)\n    groups = np.asarray([str(ref[key][\"full_inchikey\"]) for key in ids])\n    unique,inverse = np.unique(groups,return_inverse=True)\n    errors = np.asarray([np.bincount(inverse,weights=np.abs(y-value),minlength=len(unique)) for value in p])\n    references = np.asarray([np.bincount(inverse,weights=np.abs(y-mean),minlength=len(unique)) for mean in means])\n    divisors = references.sum(axis=1)\n    if np.any(divisors <= 0):\n        raise IncompleteComparison(\"A TRAIN-mean reference has zero error on the comparison population\")\n    rae = errors.sum(axis=1)/divisors\n    draws = np.empty(1000,float);rng = np.random.default_rng(SEED)\n    for index in range(1000):\n        sample = rng.integers(0,len(unique),size=len(unique))\n        divisor = references[:,sample].sum(axis=1)\n        if np.any(divisor <= 0):\n            raise IncompleteComparison(\"A whole-molecule paired draw has zero TRAIN-reference error\")\n        values = errors[:,sample].sum(axis=1)/divisor\n        draws[index] = values[0]-values[1]\n    lower,upper = map(float,np.quantile(draws,[.025,.975]))\n    answer = dict(reference_RAE=float(rae[0]),candidate_RAE=float(rae[1]),\n                  reference_MAE=float(np.abs(y-p[0]).mean()),candidate_MAE=float(np.abs(y-p[1]).mean()),\n                  pooled_RAE_improvement=float(rae[0]-rae[1]),\n                  paired_RAE_improvement_CI95_low=lower,paired_RAE_improvement_CI95_high=upper,\n                  paired_RAE_improvement_SE=float(draws.std(ddof=1)),bootstrap_draws=1000,\n                  common_TEST_rows=len(ids),common_TEST_molecules=len(unique),\n                  original_reference_rows=len(ref),original_candidate_rows=len(cand),\n                  reference_rows_outside_common_available_population=len(ref)-len(ids),\n                  candidate_rows_outside_common_available_population=len(cand)-len(ids),\n                  comparison_population=\"DECLARED_COMMON_NATIVE_FEATURES\" if allow_native_missing else \"IDENTICAL_ORIGINAL_TEST\",\n                  training_mean_policy=\"Each method retains its actual fit TRAIN mean; no TEST mean\",\n                  significance_method=\"PAIRED_MOLECULE_BOOTSTRAP95\",\n                  significant_improvement=lower > 0)\n    if scaffold_cv:\n        from scipy.stats import tukey_hsd\n        for side in (ref,cand):\n            observed={(row.get(\"repetition\"),row.get(\"fold\")) for row in side.values()}\n            if observed != FOLDS:\n                raise IncompleteComparison(\"Every registered CV fold is required\")\n        scores = [[],[]]\n        for repetition,fold in sorted(FOLDS):\n            selected=np.asarray([i for i,key in enumerate(ids) if\n                (ref[key][\"repetition\"],ref[key][\"fold\"])==(repetition,fold)],int)\n            if not len(selected):\n                raise IncompleteComparison(\"Native missingness emptied a registered common CV fold\")\n            for method in range(2):\n                denominator=float(np.abs(y[selected]-means[method,selected]).sum())\n                if denominator <= 0:\n                    raise IncompleteComparison(\"A registered CV fold has zero TRAIN-reference error\")\n                scores[method].append(float(np.abs(y[selected]-p[method,selected]).sum()/denominator))\n        test=tukey_hsd(*scores)\n        difference=float(test.statistic[0,1]);pvalue=float(test.pvalue[0,1])\n        answer.update(significance_method=\"TUKEY_HSD_25_ORIGINAL_SCAFFOLD_FOLDS\",\n                      reference_mean25_RAE=float(np.mean(scores[0])),candidate_mean25_RAE=float(np.mean(scores[1])),\n                      Tukey_mean_RAE_improvement=difference,Tukey_pvalue=pvalue,\n                      significant_improvement=bool(math.isfinite(pvalue) and pvalue<.05 and difference>0))\n    return answer\n\ndef needs_second_seed(*, learner, final_role, significant_improvement,\n                      current_seed_count=1, rollback_lost_samples=False):\n    \"\"\"Traditional ML stays at one seed; neural configurations never exceed two.\"\"\"\n    if type(current_seed_count) is not int or current_seed_count not in (1,2):\n        raise ValueError(\"One or two actual completed seeds must be declared\")\n    if current_seed_count==2 or learner not in (\"TabPFN\",\"Chemprop-v2\"):\n        return False\n    if rollback_lost_samples:\n        return True\n    return final_role in (\"RETAIN\",\"APPENDIX\") and significant_improvement is True\n\ndef baseline_confirmation_plan(screen, predictions):\n    \"\"\"Confirm a final Chemprop winner against its strongest traditional control.\"\"\"\n    from .selection import BASELINES\n    from .reporting import CV_DATASETS, primary_rows\n    plan, comparisons = [], []\n    for record in screen:\n        if (record.get(\"status\") != \"SCREENED\" or\n                record.get(\"decision\") not in (\"RETAIN\",\"APPENDIX\") or\n                record.get(\"best_baseline\") != \"Chemprop-v2\"):\n            continue\n        key=record[\"endpoint_key\"];dataset=record[\"dataset\"]\n        controls=[name for name in BASELINES if name!=\"Chemprop-v2\"]\n        reference=min(controls,key=lambda name:record[name+\"_RAE\"])\n        result=paired_improvement(primary_rows(dataset,predictions[key][reference]),\n                                  primary_rows(dataset,predictions[key][\"Chemprop-v2\"]),\n                                  scaffold_cv=dataset in CV_DATASETS)\n        comparisons.append(dict(endpoint_key=key,dataset=dataset,target=record[\"target\"],\n                                reference_model=reference,candidate_model=\"Chemprop-v2\",**result))\n        if needs_second_seed(learner=\"Chemprop-v2\",final_role=record[\"decision\"],\n                             significant_improvement=result[\"significant_improvement\"]):\n            plan.append(dict(endpoint_key=key,dataset=dataset,target=record[\"target\"],\n                             model=\"Chemprop-v2\",producer_task=primary_rows(dataset,predictions[key][\"Chemprop-v2\"])[0][\"task\"],primary_seed=SEED,confirmation_seed=SEED+1,\n                             frozen_B1_decision=record[\"decision\"],reason=\"FINAL_SIGNIFICANT_IMPROVEMENT\",\n                             reference_model=reference,significance_method=result[\"significance_method\"],\n                             task_roster_reselection=False,original_folds_or_split_unchanged=True))\n    return plan,comparisons\n"]]:
    module=types.ModuleType('workflows.benchmark_evaluation.'+name);module.__package__=package.__name__;sys.modules[module.__name__]=module;exec(compile(source,module.__name__,'exec'),module.__dict__)
import csv,hashlib,io,json,os,re,subprocess,time
from collections import Counter
from pathlib import Path
from workflows.benchmark_data.admission import protect
from workflows.benchmark_evaluation.reporting import ClosedPredictionConsumer,IncompleteComparison,resolve_array_run
from workflows.benchmark_evaluation.comparisons import baseline_confirmation_plan
entry=json.loads(Path('configs/benchmark_data/B0.DELIVERY.json').read_text())
root=Path(entry['data_root']);b1=root.parent/'benchmark_B1_20261119'
quota=Path('/share/home/zixiao/descriptor_analysis/runs/data_v1_20261025/control/benchmark_B0_quota_20261119.json')
def safe():protect(root,512*1024**2,quota,own_concurrent_bytes=40*1024**3)
safe()
catalog_root=b1/'endpoint_catalog/job_4536889';proof=json.loads((catalog_root/'manifest.json').read_text())
assert proof['deferred_registry_full_inventory_verified'] is True and proof['deferred_endpoint_count']==5 and proof['candidate_endpoint_count']==96
with (catalog_root/'candidate_endpoints.csv').open(newline='') as stream:catalog=list(csv.DictReader(stream))
specs=json.loads("[{\"job\":4536910,\"folder\":\"B1_RF_LGBM/job_4536910\"},{\"job\":4536953,\"folder\":\"B1_RF_LGBM/job_4536953\"},{\"job\":4536968,\"folder\":\"B1_RF_LGBM/job_4536968\"},{\"job\":4537018,\"folder\":\"B1_RF_LGBM/job_4537018\"},{\"job\":4537023,\"folder\":\"B1_RF_LGBM/job_4537023\"},{\"job\":4536913,\"folder\":\"B1_Chemprop/job_4536913\"},{\"job\":4536954,\"folder\":\"B1_Chemprop/job_4536954\"},{\"job\":4537200,\"folder\":\"B1_Chemprop/job_4537200\"},{\"job\":4537262,\"folder\":\"B1_Chemprop/job_4537262\"},{\"job\":4537203,\"folder\":\"B1_Chemprop/job_4537203\"},{\"job\":4537322,\"folder\":\"B1_RF_LGBM_NMR/job_4537322\"},{\"job\":4537337,\"folder\":\"B1_Chemprop_NMR/job_4537337\"},{\"job\":4536999,\"model\":\"RF-ECFP4\",\"folder\":\"reference_cv_models/job_4536999\"},{\"job\":4537000,\"model\":\"LightGBM-RDKit2D\",\"folder\":\"reference_cv_models/job_4537000\"},{\"job\":4537263,\"model\":\"Chemprop-v2\",\"folder\":\"reference_cv_models/job_4537263\"},{\"job\":4537003,\"model\":\"RF-ECFP4\",\"folder\":\"reference_cv_models/job_4537003\"},{\"job\":4537004,\"model\":\"LightGBM-RDKit2D\",\"folder\":\"reference_cv_models/job_4537004\"},{\"job\":4537264,\"model\":\"Chemprop-v2\",\"folder\":\"reference_cv_models/job_4537264\"},{\"job\":4537025,\"model\":\"RF-ECFP4\",\"folder\":\"reference_cv_models/job_4537025\"},{\"job\":4537026,\"model\":\"LightGBM-RDKit2D\",\"folder\":\"reference_cv_models/job_4537026\"},{\"job\":4537323,\"model\":\"RF-ECFP4\",\"folder\":\"reference_cv_models/job_4537323\"},{\"job\":4537031,\"model\":\"LightGBM-RDKit2D\",\"folder\":\"reference_cv_models/job_4537031\"},{\"job\":4537324,\"model\":\"RF-ECFP4\",\"folder\":\"reference_cv_models/job_4537324\"},{\"job\":4537036,\"model\":\"LightGBM-RDKit2D\",\"folder\":\"reference_cv_models/job_4537036\"},{\"job\":4537325,\"model\":\"RF-ECFP4\",\"folder\":\"reference_cv_models/job_4537325\"},{\"job\":4537041,\"model\":\"LightGBM-RDKit2D\",\"folder\":\"reference_cv_models/job_4537041\"},{\"job\":4537326,\"model\":\"RF-ECFP4\",\"folder\":\"reference_cv_models/job_4537326\"},{\"job\":4537046,\"model\":\"LightGBM-RDKit2D\",\"folder\":\"reference_cv_models/job_4537046\"},{\"job\":4537327,\"model\":\"RF-ECFP4\",\"folder\":\"reference_cv_models/job_4537327\"},{\"job\":4537051,\"model\":\"LightGBM-RDKit2D\",\"folder\":\"reference_cv_models/job_4537051\"},{\"job\":4537328,\"model\":\"RF-ECFP4\",\"folder\":\"reference_cv_models/job_4537328\"},{\"job\":4537056,\"model\":\"LightGBM-RDKit2D\",\"folder\":\"reference_cv_models/job_4537056\"},{\"job\":4537329,\"model\":\"RF-ECFP4\",\"folder\":\"reference_cv_models/job_4537329\"},{\"job\":4537061,\"model\":\"LightGBM-RDKit2D\",\"folder\":\"reference_cv_models/job_4537061\"},{\"job\":4537330,\"model\":\"RF-ECFP4\",\"folder\":\"reference_cv_models/job_4537330\"},{\"job\":4537066,\"model\":\"LightGBM-RDKit2D\",\"folder\":\"reference_cv_models/job_4537066\"},{\"job\":4537265,\"model\":\"Chemprop-v2\",\"array\":true},{\"job\":4537335,\"model\":\"Chemprop-v2\",\"array\":true},{\"job\":4537355,\"model\":\"Chemprop-v2\",\"array\":true},{\"job\":4537268,\"model\":\"Chemprop-v2\",\"array\":true},{\"job\":4537269,\"model\":\"Chemprop-v2\",\"array\":true},{\"job\":4537270,\"model\":\"Chemprop-v2\",\"array\":true},{\"job\":4537339,\"model\":\"Chemprop-v2\",\"array\":true},{\"job\":4537272,\"model\":\"Chemprop-v2\",\"array\":true},{\"job\":4537273,\"model\":\"Chemprop-v2\",\"array\":true}]")
job_ids=','.join(str(s['job']) for s in specs)
raw=subprocess.check_output(['ssh','-n','-o','BatchMode=yes','-o','ConnectTimeout=10','sonmi','sacct','-j',job_ids,'-X','--noheader','--parsable2','-o','JobID,JobIDRaw,State,ExitCode,NodeList'],text=True,timeout=60)
accounting={}
for line in raw.splitlines():
    fields=line.strip().split('|')
    if len(fields)<5:continue
    name,actual,state,exit_code,node=fields[:5]
    if not re.fullmatch(r'[0-9]+(?:_[0-9]+)?',name):continue
    if name in accounting:raise IncompleteComparison('Duplicate native accounting identity: '+name)
    accounting[name]=dict(actual_job=actual,state=state.split()[0].rstrip('+'),exit_code=exit_code,node=node)
terminal={'COMPLETED','FAILED','CANCELLED','TIMEOUT','OUT_OF_MEMORY','NODE_FAIL','BOOT_FAIL','PREEMPTED','DEADLINE'}
for spec in specs:
    names=[str(spec['job'])+'_'+str(i) for i in range(5)] if spec.get('array') else [str(spec['job'])]
    if any(name not in accounting or accounting[name]['state'] not in terminal for name in names):
        raise IncompleteComparison('The final screen waits for all native producers, including every array repetition')
out=b1/'B1_task_screen'/('job_'+os.environ['SLURM_JOB_ID'])
# Preserve every old invocation. Only producer-error recovery may precede a final CSV.
safe();out.parent.mkdir(exist_ok=True)
if list(out.parent.glob('job_*/B1_task_screen.csv')):
    raise IncompleteComparison('A final B1 roster already exists; no second screen or revision')
safe();out.mkdir()
consumer=ClosedPredictionConsumer(catalog)
array_manifests=None
for spec in specs:
    names=[str(spec['job'])+'_'+str(i) for i in range(5)] if spec.get('array') else [str(spec['job'])]
    for name in names:
        safe();native=accounting[name]
        if spec.get('array'):
            if array_manifests is None:
                array_manifests=[(path.parent,json.loads(path.read_text()))
                    for path in (b1/'reference_cv_models').glob('job_*/manifest.json')]
            folder=resolve_array_run(array_manifests,spec['job'],int(name.rsplit('_',1)[1]))
        else:folder=b1/spec['folder']
        consumer.add_run(folder,native['state'],expected_model=spec.get('model'),array_job=spec['job'] if spec.get('array') else None)
screen,diagnostics,tukey=consumer.screen_once(proof, unresolved={})
confirmation_plan,baseline_comparisons=baseline_confirmation_plan(screen,consumer.predictions)
for row in confirmation_plan:
    if row['dataset']=='NMRShiftDB2' and row['target']=='1H':
        row.update(actual_training_sample_redo_requires_second_seed=True,confirmation_native_job=4537338,reason='SOURCE_BINDING_ERROR_REQUIRED_REDO_OF_TRAINED_1H_SAMPLES')
if not any(row['dataset']=='NMRShiftDB2' and row['target']=='1H' for row in confirmation_plan):
    native_endpoint=next(r for r in screen if r['dataset']=='NMRShiftDB2' and r['target']=='1H')
    confirmation_plan.append(dict(endpoint_key=native_endpoint['endpoint_key'],dataset='NMRShiftDB2',target='1H',producer_task='1H',model='Chemprop-v2',primary_seed=20261025,confirmation_seed=20261026,confirmation_native_job=4537338,frozen_B1_decision=native_endpoint['decision'],reason='SOURCE_BINDING_ERROR_REQUIRED_REDO_OF_TRAINED_1H_SAMPLES',task_roster_reselection=False,original_folds_or_split_unchanged=True))
def deliver_csv(name,rows,final_sha=False):
    fields=list(dict.fromkeys(key for row in rows for key in row))
    stream=io.StringIO(newline='');writer=csv.DictWriter(stream,fieldnames=fields or ['status'],lineterminator='\n')
    writer.writeheader();writer.writerows(rows);payload=stream.getvalue().encode('utf-8')
    safe();(out/name).write_bytes(payload)
    if final_sha:
        digest=hashlib.sha256(payload).hexdigest();(out/(name+'.sha256')).write_text(digest+'  '+name+'\n');return digest
digest=deliver_csv('B1_task_screen.csv',screen,True)
deliver_csv('B1_filter_impact.csv',diagnostics)
deliver_csv('B1_scaffold_Tukey_HSD.csv',tukey)
deliver_csv('B1_Chemprop_seed2_plan.csv',confirmation_plan)
deliver_csv('B1_Chemprop_paired_comparisons.csv',baseline_comparisons)
report=dict(status='FINAL_B1_SINGLE_SCREEN_CLOSED',job=os.environ['SLURM_JOB_ID'],source_catalog=str(catalog_root/'manifest.json'),active_endpoints=len(screen),decision_counts=dict(Counter(r['decision'] for r in screen)),screen_csv=str(out/'B1_task_screen.csv'),screen_sha256=digest,filter_impact_rows=len(diagnostics),Tukey_pair_rows=len(tukey),neural_second_seed_configurations=len(confirmation_plan),second_seed_plan=str(out/'B1_Chemprop_seed2_plan.csv'),second_seed_changes_frozen_roster=False,producer_sources=consumer.sources,native_accounting=accounting,protocol='Three pre-registered baselines only;1000 paired whole-molecule bootstrap; fixed25-fold scaffold Tukey; original TRAIN-mean RAE; no C1 or MFM task selection',original_appendix_roles_preserved=True,independent_numeric_QA=False,second_screen_or_roster_revision_permitted=False)
safe();(out/'manifest.json').write_text(json.dumps(report,indent=2)+'\n')
print('FINAL_B1_SCREEN_CLOSED',out/'manifest.json','decisions',report['decision_counts'],'sha256',digest,flush=True)

PY
B1FINALSCREEN
