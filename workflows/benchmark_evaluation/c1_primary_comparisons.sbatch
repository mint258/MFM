raw=subprocess.check_output(['ssh','-n','-o','BatchMode=yes','-o','ConnectTimeout=10','sonmi','sacct','-j',job_ids,'-X','--noheader','--parsable2','-o','JobID,JobIDRaw,State,ExitCode,NodeList'],text=True,timeout=60)
accounting={}
for line in raw.splitlines():
    fields=line.strip().split('|')
    if len(fields)<5:continue
    name,actual,state,exit_code,node=fields[:5]
    if not re.fullmatch(r'[0-9]+(?:_[0-9]+)?',name):continue
    if name in accounting:raise IncompleteComparison('Duplicate native source accounting identity')
    accounting[name]=dict(actual_job=actual,state=state.split()[0].rstrip('+'),exit_code=exit_code,node=node)
for spec in specs+c1_specs:
    names=[str(spec['job'])+'_'+str(i) for i in range(5)] if spec.get('array') else [str(spec['job'])]
    if any(name not in accounting or accounting[name]['state'] not in TERMINAL for name in names):
        raise IncompleteComparison('C1 primary report waits for all declared B1/C1 source producers')
out=b1/'C1_primary_comparisons'/('job_'+os.environ['SLURM_JOB_ID'])
if list(out.parent.glob('job_*/manifest.json')):raise IncompleteComparison('Primary C1 report already exists; no independent statistics replay')
safe();out.mkdir(parents=True)
consumer=ClosedPredictionConsumer(catalog)
array_manifests=None
for spec in specs:
    names=[str(spec['job'])+'_'+str(i) for i in range(5)] if spec.get('array') else [str(spec['job'])]
    for name in names:
        safe();native=accounting[name]
        if spec.get('array'):
            if array_manifests is None:
                array_manifests=[(path.parent,json.loads(path.read_text()))
                    for path in (b1/'reference_cv_models').glob('job_*/manifest.json')]
            folder=resolve_array_run(array_manifests,spec['job'],int(name.rsplit('_',1)[1]))
        else:folder=b1/spec['folder']
        consumer.add_run(folder,native['state'],expected_model=spec.get('model'),array_job=spec['job'] if spec.get('array') else None)
baselines={key:{model:primary_rows(next(r['dataset'] for r in catalog if r['endpoint_key']==key),rows)
                for model,rows in models.items()} for key,models in consumer.predictions.items()}
native=C1ClosedConsumer(catalog)
for spec in c1_specs:
    safe();native.add_run(b1/spec['folder'],accounting[str(spec['job'])]['state'],spec)
table,contrasts,plan=make_primary_report(catalog,screen,baselines,native.predictions,unresolved=native.unresolved_cells,fit_metadata=native.fit_metadata)
def deliver_csv(name,rows):
    fields=list(dict.fromkeys(k for row in rows for k in row))
    stream=io.StringIO(newline='');writer=csv.DictWriter(stream,fieldnames=fields or ['status'],lineterminator='\n')
    writer.writeheader();writer.writerows(rows);safe();(out/name).write_text(stream.getvalue())
deliver_csv('C1_primary_seed_results.csv',table)
deliver_csv('C1_registered_paired_comparisons.csv',contrasts)
deliver_csv('C1_TabPFN_seed2_plan.csv',plan)
report=dict(status='C1_PRIMARY_STATISTICS_CLOSED_CONDITIONAL_CONFIRMATION_REQUIRED',job=os.environ['SLURM_JOB_ID'],
    frozen_B1_roster=str(frozen[0]),task_roster_reselection=False,reported_configuration_rows=len(table),
    result_states=dict(Counter(row['status'] for row in table)),registered_paired_contrasts=len(contrasts),
    required_TabPFN_confirmation_configurations=len(plan),second_seed_plan=str(out/'C1_TabPFN_seed2_plan.csv'),
    original_TEST_kept_for_other_models=True,missing_native_features_imputed=False,
    C1_sources=native.sources,B1_sources=consumer.sources,native_accounting=accounting,
    C1_final_table=False,final_SHA_produced=False,independent_numeric_QA=False)
safe();(out/'manifest.json').write_text(json.dumps(report,indent=2)+'\n')
print('C1_PRIMARY_COMPARISONS_CLOSED',out/'manifest.json','rows',len(table),'conditional_seeds',len(plan),flush=True)

