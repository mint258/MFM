sbatch <<'FINALC1EXPORT'
#!/bin/bash
#SBATCH --job-name=C1-final-confirmed-results
#SBATCH --partition=cpu
#SBATCH --exclude=compute-0-2,compute-0-18,compute-0-21
#SBATCH --cpus-per-task=2
#SBATCH --ntasks=1
#SBATCH --nodes=1
#SBATCH --time=01:00:00
#SBATCH --output=/share/home/zixiao/descriptor_analysis/runs/data_v1_20261025/control/C1_final_confirmed_results_%j.log
set -euo pipefail
repo=/share/home/zixiao/descriptor_analysis/runs/data_v1_20261025/worktrees/benchmark_b1_20261119
export PYTHONPATH="$repo:/share/home/zixiao/descriptor_analysis/runs/data_v1_20261025/artifacts/benchmark_B0_20261119/runtime_deps:/share/home/zixiao/descriptor_analysis/docs/phase1/evidence/stage61_data_input_audit_v1/scan_v2/deps"
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 CUDA_VISIBLE_DEVICES='' PYTHONDONTWRITEBYTECODE=1
cd "$repo"
findmnt -T "$repo"
df -B1 "$repo" /tmp
df -Pi "$repo" /tmp
/share/home/zixiao/.conda/envs/chemprop/bin/python -B - <<'PY'
import sys,types
package=types.ModuleType('workflows.benchmark_evaluation');package.__path__=[];sys.modules[package.__name__]=package
for name,source in [["selection","\"\"\"Pre-registered B1 decisions and scaffold folds; no fitting or result selection.\"\"\"\nfrom itertools import combinations\nimport math\nimport numpy as np\n\nBASELINES = (\"RF-ECFP4\", \"LightGBM-RDKit2D\", \"Chemprop-v2\")\nSEED = 20261025\n\nclass IncompleteComparison(ValueError):\n    \"\"\"A comparison cannot be made on unaligned or incomplete predictions.\"\"\"\n\ndef align_predictions(predictions):\n    \"\"\"Require identical IDs, original labels, molecular groups, and references.\"\"\"\n    if set(predictions) != set(BASELINES):\n        raise IncompleteComparison(\"All three pre-registered B1 baselines are required\")\n    indexed = {}\n    for name in BASELINES:\n        rows = predictions[name]\n        if any(row[\"evaluation_id\"] is None or not str(row[\"evaluation_id\"]).strip()\n               or not row[\"full_inchikey\"] for row in rows):\n            raise IncompleteComparison(\"Missing evaluation or complete molecule identity\")\n        mapping = {str(row[\"evaluation_id\"]): row for row in rows}\n        if not mapping or len(mapping) != len(rows):\n            raise IncompleteComparison(\"Missing or duplicate evaluation IDs\")\n        indexed[name] = mapping\n    ids = sorted(indexed[BASELINES[0]])\n    first = indexed[BASELINES[0]]\n    y = np.asarray([first[key][\"y_true\"] for key in ids], dtype=float)\n    means = np.asarray([first[key][\"training_mean\"] for key in ids], dtype=float)\n    groups = np.asarray([str(first[key][\"full_inchikey\"]) for key in ids])\n    values = []\n    if not np.isfinite(y).all() or not np.isfinite(means).all():\n        raise IncompleteComparison(\"Nonfinite labels or TRAIN means\")\n    if any(not str(first[key][\"full_inchikey\"]) for key in ids):\n        raise IncompleteComparison(\"Missing complete molecular identity\")\n    for name in BASELINES:\n        mapping = indexed[name]\n        if set(mapping) != set(ids):\n            raise IncompleteComparison(\"Evaluation populations differ; do not intersect them\")\n        other_y = np.asarray([mapping[key][\"y_true\"] for key in ids], dtype=float)\n        other_means = np.asarray([mapping[key][\"training_mean\"] for key in ids], dtype=float)\n        other_groups = np.asarray([str(mapping[key][\"full_inchikey\"]) for key in ids])\n        if not (np.array_equal(y, other_y) and np.array_equal(means, other_means)\n                and np.array_equal(groups, other_groups)):\n            raise IncompleteComparison(\"Labels, TRAIN references, or molecule groups differ\")\n        prediction = np.asarray([mapping[key][\"prediction\"] for key in ids], dtype=float)\n        if not np.isfinite(prediction).all():\n            raise IncompleteComparison(\"Missing predictions must not redefine the test population\")\n        values.append(prediction)\n    return ids, y, means, groups, np.asarray(values)\n\ndef paired_bootstrap(predictions, draws=1000, seed=SEED):\n    \"\"\"Resample whole molecules identically across the three baseline predictions.\"\"\"\n    if draws != 1000:\n        raise ValueError(\"The registered B1 protocol requires 1000 draws\")\n    ids, y, means, groups, values = align_predictions(predictions)\n    unique, inverse = np.unique(groups, return_inverse=True)\n    error = np.asarray([\n        np.bincount(inverse, weights=np.abs(y - value), minlength=len(unique))\n        for value in values\n    ])\n    reference = np.bincount(inverse, weights=np.abs(y - means), minlength=len(unique))\n    denominator = float(reference.sum())\n    if denominator <= 0:\n        raise IncompleteComparison(\"TRAIN-mean reference has zero error\")\n    rae = error.sum(axis=1) / denominator\n    bootstrap = np.empty((draws, len(BASELINES)), dtype=float)\n    rng = np.random.default_rng(seed)\n    for index in range(draws):\n        sample = rng.integers(0, len(unique), size=len(unique))\n        divisor = float(reference[sample].sum())\n        if divisor <= 0:\n            raise IncompleteComparison(\"A molecule-bootstrap draw has zero reference error\")\n        bootstrap[index] = error[:, sample].sum(axis=1) / divisor\n    best_index = int(np.argmin(rae))\n    worst_index = int(np.argmax(rae))\n    paired_range = bootstrap[:, worst_index] - bootstrap[:, best_index]\n    standard_error = float(paired_range.std(ddof=1))\n    return {\n        \"baseline_order\": list(BASELINES),\n        \"RAE\": rae.tolist(),\n        \"RAE_CI95_low\": np.quantile(bootstrap, .025, axis=0).tolist(),\n        \"RAE_CI95_high\": np.quantile(bootstrap, .975, axis=0).tolist(),\n        \"best_baseline\": BASELINES[best_index],\n        \"best_index\": best_index,\n        \"worst_baseline\": BASELINES[worst_index],\n        \"RAE_range\": float(rae[worst_index] - rae[best_index]),\n        \"paired_best_worst_bootstrap_SE\": standard_error,\n        \"discrimination_threshold\": max(.02, 2 * standard_error),\n        \"molecule_bootstrap_draws\": draws,\n        \"n_test_rows\": len(ids),\n        \"n_test_molecules\": len(unique),\n    }\n\ndef decide_endpoint(predictions, *, n_filtered_labeled_points, scope_proof):\n    \"\"\"Apply the task rule once, after completeness; never use C1 or our models.\"\"\"\n    if (scope_proof.get(\"deferred_registry_full_inventory_verified\") is not True\n            or scope_proof.get(\"deferred_endpoint_count\") != 5):\n        raise IncompleteComparison(\"The complete five-endpoint scope proof is required\")\n    if not isinstance(n_filtered_labeled_points, int) or n_filtered_labeled_points < 0:\n        raise ValueError(\"Provide the whole filtered endpoint's labeled point count\")\n    result = paired_bootstrap(predictions)\n    best = result[\"best_index\"]\n    if n_filtered_labeled_points < 30:\n        decision, reason = \"APPENDIX\", \"FEWER_THAN_30_FILTERED_LABELED_POINTS\"\n    elif result[\"RAE\"][best] >= .90 and result[\"RAE_CI95_high\"][best] >= .85:\n        decision, reason = \"EXCLUDE\", \"INSUFFICIENT_SIGNAL\"\n    elif result[\"RAE_range\"] < result[\"discrimination_threshold\"]:\n        decision, reason = \"APPENDIX\", \"INSUFFICIENT_DISCRIMINATION\"\n    else:\n        decision, reason = \"RETAIN\", \"PASSED_REGISTERED_B1_RULE\"\n    return dict(result, decision=decision, reason=reason,\n                n_filtered_labeled_points=n_filtered_labeled_points)\n\ndef scaffold_folds(scaffold_groups, seed=SEED):\n    \"\"\"Yield five repetitions of five disjoint scaffold-group folds.\"\"\"\n    groups = np.asarray(scaffold_groups, dtype=str)\n    unique, inverse = np.unique(groups, return_inverse=True)\n    if len(unique) < 5:\n        raise IncompleteComparison(\"Fewer than five scaffolds; do not replace with a random split\")\n    members = [np.flatnonzero(inverse == index) for index in range(len(unique))]\n    streams = np.random.SeedSequence(seed).spawn(5)\n    for repetition, stream in enumerate(streams):\n        rng = np.random.default_rng(stream)\n        order = rng.permutation(len(unique))\n        assignments = [[] for _ in range(5)]\n        sizes = np.zeros(5, dtype=int)\n        for index in order:\n            candidates = np.flatnonzero(sizes == sizes.min())\n            fold = int(rng.choice(candidates))\n            assignments[fold].extend(members[index].tolist())\n            sizes[fold] += len(members[index])\n        for fold, selected in enumerate(assignments):\n            test = np.sort(np.asarray(selected, dtype=int))\n            train = np.setdiff1d(np.arange(len(groups)), test)\n            if not len(train) or not len(test):\n                raise IncompleteComparison(\"Empty scaffold fold; no split substitution allowed\")\n            yield repetition, fold, train, test\n\ndef tukey_cv(fold_scores):\n    \"\"\"Use the registered 25 scaffold-fold scores for Tukey HSD comparisons.\"\"\"\n    from scipy.stats import tukey_hsd\n    required = {(repetition, fold) for repetition in range(5) for fold in range(5)}\n    if set(fold_scores) != set(BASELINES):\n        raise IncompleteComparison(\"All three baselines are required for Tukey HSD\")\n    samples = []\n    for name in BASELINES:\n        rows = fold_scores[name]\n        if len(rows) != 25 or set(rows) != required:\n            raise IncompleteComparison(\"Each model needs the same 25 scaffold folds\")\n        values = np.asarray([rows[key] for key in sorted(required)], dtype=float)\n        if not np.isfinite(values).all():\n            raise IncompleteComparison(\"Missing fold scores cannot be discarded\")\n        samples.append(values)\n    comparison = tukey_hsd(*samples)\n    return [\n        {\"left\": BASELINES[left], \"right\": BASELINES[right],\n         \"mean_RAE_difference\": float(comparison.statistic[left, right]),\n         \"pvalue\": float(comparison.pvalue[left, right])}\n        for left, right in combinations(range(len(BASELINES)), 2)\n    ]\n"],["finalization","\"\"\"Close required neural confirmations without changing frozen tasks or replaying primary scores.\"\"\"\nimport math\nfrom .selection import IncompleteComparison,SEED\n\ndef cell_key(row,baseline=False):\n    return (row[\"endpoint_key\"],row.get(\"model\",\"Chemprop-v2\")) if baseline else (\n        row[\"endpoint_key\"],row[\"feature_group\"],row[\"learner\"])\n\ndef _unique(rows,baseline=False):\n    result={}\n    for row in rows:\n        key=cell_key(row,baseline)\n        if key in result:raise IncompleteComparison(\"Duplicate final-report configuration: \"+repr(key))\n        result[key]=row\n    return result\n\ndef _closed_confirmation(plan,evidence):\n    if evidence.get(\"model_seed\")!=SEED+1:\n        raise IncompleteComparison(\"Confirmation model seed differs from the registered second seed\")\n    if evidence.get(\"split_and_statistics_seed\")!=SEED:\n        raise IncompleteComparison(\"A confirmation changed the frozen split/statistics seed\")\n    if evidence.get(\"original_labels_or_masks_changed\",False) or evidence.get(\"task_roster_reselection\",False):\n        raise IncompleteComparison(\"A confirmation changed original scientific inputs or the task roster\")\n    if evidence.get(\"status\")==\"UNRESOLVED\":\n        if not evidence.get(\"native_failure_reason\") or not evidence.get(\"sources\"):\n            raise IncompleteComparison(\"An unresolved confirmation requires actual native failure evidence\")\n        return dict(completed=False,confirmation_status=\"SECOND_SEED_UNRESOLVED_NATIVE_FAILURE\",\n                    confirmation_reason=evidence[\"native_failure_reason\"])\n    if evidence.get(\"status\")!=\"COMPLETED\" or not evidence.get(\"sources\"):\n        raise IncompleteComparison(\"Required confirmation is still pending or lacks native source binding\")\n    stats=evidence.get(\"statistics\",{})\n    if any(not isinstance(stats.get(key),(int,float)) or isinstance(stats[key],bool)\n           or not math.isfinite(stats[key]) for key in (\"MAE\",\"RAE\")):\n        raise IncompleteComparison(\"Closed confirmation lacks finite original-unit MAE/RAE\")\n    if stats.get(\"n_test_rows\",0)<1:\n        raise IncompleteComparison(\"Closed confirmation has no original TEST observations\")\n    comparisons=evidence.get(\"comparisons\",[])\n    names=[row[\"comparison\"] for row in comparisons]\n    if len(set(names))!=len(names):\n        raise IncompleteComparison(\"Duplicate second-seed registered comparison\")\n    triggering=plan.get(\"triggering_comparisons\") or evidence.get(\"original_significant_comparisons\")\n    if triggering is None and plan[\"reason\"]==\"FINAL_SIGNIFICANT_IMPROVEMENT\":\n        triggering=[plan.get(\"triggering_comparison\",plan.get(\"reference_model\"))]\n    triggering=[] if triggering is None else triggering\n    if not isinstance(triggering,(list,tuple)) or any(not isinstance(name,str) or not name for name in triggering):\n        raise IncompleteComparison(\"Original significant comparison identities must be an explicit list\")\n    if len(set(triggering))!=len(triggering):\n        raise IncompleteComparison(\"Duplicate original significant comparison identity\")\n    if not set(triggering).issubset(names):\n        raise IncompleteComparison(\"An original significant comparison lacks second-seed evidence\")\n    first=plan.get(\"triggering_comparison\",plan.get(\"reference_model\"))\n    if plan[\"reason\"]==\"FINAL_SIGNIFICANT_IMPROVEMENT\" and (not triggering or first not in triggering):\n        raise IncompleteComparison(\"Required original triggering comparison is absent\")\n    reproduced=[row[\"comparison\"] for row in comparisons\n                if row[\"comparison\"] in triggering and row[\"significant_improvement\"]]\n    summary=dict(original_significant_comparisons=list(triggering),\n                 reproduced_significant_comparisons=reproduced,\n                 confirmation_comparisons_required=len(triggering),\n                 confirmation_comparisons_reproduced=len(reproduced))\n    if plan[\"reason\"]==\"FINAL_SIGNIFICANT_IMPROVEMENT\":\n        if len(reproduced)==len(triggering):state=\"SECOND_SEED_SIGNIFICANT_IMPROVEMENT_REPRODUCED\"\n        elif reproduced:state=\"SECOND_SEED_SIGNIFICANT_IMPROVEMENT_PARTIALLY_REPRODUCED\"\n        else:state=\"SECOND_SEED_DID_NOT_REPRODUCE_SIGNIFICANCE\"\n    elif plan[\"reason\"] in {\"TRAINING_ROLLBACK_REDO\",\"SOURCE_BINDING_ERROR_REQUIRED_REDO_OF_TRAINED_1H_SAMPLES\"}:\n        state=\"REQUIRED_TRAINING_REDO_SECOND_SEED_REPORTED\"\n    else:\n        raise IncompleteComparison(\"Unregistered neural confirmation reason\")\n    return dict(completed=True,confirmation_status=state,confirmation_reason=plan[\"reason\"],**summary)\n\ndef finalize_c1(primary_rows,required_plan,evidence):\n    \"\"\"Return both seed rows. Primary estimates are copied exactly, never recalculated.\"\"\"\n    primary=_unique(primary_rows)\n    plans=_unique(required_plan)\n    if set(evidence)!=set(plans):\n        raise IncompleteComparison(\"Every required confirmation must close; unplanned second seeds are rejected\")\n    if not set(plans).issubset(primary):\n        raise IncompleteComparison(\"A second seed cannot introduce a new C1 task or configuration\")\n    table=[];contrasts=[]\n    for key,original in primary.items():\n        row=dict(original,report_stage=\"FINAL\",task_roster_reselection=False,\n                 primary_statistics_recomputed=False)\n        if key not in plans:\n            row.update(confirmation_status=\"NOT_REQUIRED_UNDER_ONE_SEED_RULE\")\n            table.append(row);continue\n        plan=plans[key]\n        if plan[\"learner\"]!=\"TabPFN\" or plan[\"reason\"]!=\"FINAL_SIGNIFICANT_IMPROVEMENT\":\n            raise IncompleteComparison(\"Traditional ML never acquires a second seed\")\n        if plan.get(\"frozen_B1_role\") not in {\"RETAIN\",\"APPENDIX\"}:\n            raise IncompleteComparison(\"A nonfinal C1 cell cannot trigger improvement confirmation\")\n        native=evidence[key];closed=_closed_confirmation(plan,native)\n        row.update({k:v for k,v in closed.items() if k!=\"completed\"})\n        row[\"completed_seeds\"]=2 if closed[\"completed\"] else 1\n        row[\"confirmation_sources\"]=native[\"sources\"]\n        table.append(row)\n        if closed[\"completed\"]:\n            second=dict(original,**native.get(\"fit_metadata\",{}))\n            second.update(native[\"statistics\"])\n            second.update({k:v for k,v in closed.items() if k!=\"completed\"})\n            second.update(model_seed=SEED+1,completed_seeds=2,report_stage=\"FINAL\",\n                          confirmation_status=closed[\"confirmation_status\"],confirmation_reason=plan[\"reason\"],\n                          frozen_B1_role=original[\"frozen_B1_role\"],task_roster_reselection=False,\n                          statistics_source=\"FIRST_CPU_REPORT_OF_CLOSED_SECOND_SEED_PREDICTIONS\",\n                          primary_statistics_recomputed=False,confirmation_sources=native[\"sources\"])\n            table.append(second)\n            contrasts.extend(dict(item,endpoint_key=key[0],feature_group=key[1],learner=key[2],\n                                  model_seed=SEED+1,task_roster_reselection=False)\n                             for item in native.get(\"comparisons\",[]))\n    return table,contrasts\n\ndef finalize_baseline_confirmations(screen,required_plan,evidence):\n    \"\"\"Supplement the single frozen B1 screen; never rerun screening or modify its decisions.\"\"\"\n    roster={row[\"endpoint_key\"]:row for row in screen}\n    if len(roster)!=len(screen):raise IncompleteComparison(\"Duplicate frozen B1 endpoint\")\n    plans=_unique(required_plan,True)\n    if set(evidence)!=set(plans):raise IncompleteComparison(\"Missing or unplanned baseline confirmation\")\n    output=[]\n    for key,plan in plans.items():\n        if key[0] not in roster or key[1]!=\"Chemprop-v2\":\n            raise IncompleteComparison(\"Only a frozen original Chemprop task can acquire confirmation\")\n        native=evidence[key];closed=_closed_confirmation(plan,native)\n        result=dict(plan,**{k:v for k,v in closed.items() if k!=\"completed\"},\n                    frozen_B1_decision=roster[key[0]][\"decision\"],task_roster_reselection=False,\n                    sources=native[\"sources\"],completed_seeds=2 if closed[\"completed\"] else 1)\n        if closed[\"completed\"]:result.update(native[\"statistics\"],model_seed=SEED+1)\n        output.append(result)\n    return output\n"]]:
    module=types.ModuleType('workflows.benchmark_evaluation.'+name);module.__package__=package.__name__;sys.modules[module.__name__]=module;exec(compile(source,module.__name__,'exec'),module.__dict__)
import csv,hashlib,io,json,os
from pathlib import Path
from workflows.benchmark_data.admission import protect
from workflows.benchmark_evaluation.selection import IncompleteComparison
from workflows.benchmark_evaluation.finalization import finalize_c1,finalize_baseline_confirmations,cell_key
entry=json.loads(Path('configs/benchmark_data/B0.DELIVERY.json').read_text())
root=Path(entry['data_root']);b1=root.parent/'benchmark_B1_20261119'
quota=Path('/share/home/zixiao/descriptor_analysis/runs/data_v1_20261025/control/benchmark_B0_quota_20261119.json')
def safe():protect(root,16*1024**2,quota,own_concurrent_bytes=40*1024**3)
safe()
def unique(pattern):
    matches=list(b1.glob(pattern))
    if len(matches)!=1:raise IncompleteComparison('Exactly one closed source required: '+pattern)
    return matches[0]
def csv_rows(path):
    with path.open(newline='') as stream:return list(csv.DictReader(stream))
screen_path=unique('B1_task_screen/job_*/B1_task_screen.csv')
primary_manifest=unique('C1_primary_comparisons/job_*/manifest.json')
primary=json.loads(primary_manifest.read_text())
if primary.get('status')!='C1_PRIMARY_STATISTICS_CLOSED_CONDITIONAL_CONFIRMATION_REQUIRED' or primary.get('C1_final_table') is not False:
    raise IncompleteComparison('Original primary C1 report is not closed at the registered provisional boundary')
evidence_path=Path(os.environ['BENCHMARK_CONFIRMATION_EVIDENCE_JSON']).resolve()
if not evidence_path.is_relative_to(b1.resolve()):
    raise IncompleteComparison('Confirmation evidence must be the owned shared benchmark producer output')
evidence=json.loads(evidence_path.read_text())
if (evidence.get('status')!='CONDITIONAL_CONFIRMATION_REPORT_CLOSED'
    or evidence.get('all_declared_producers_terminal') is not True
    or evidence.get('original_TEST_binding_enforced') is not True
    or not evidence.get('native_accounting')):
    raise IncompleteComparison('Actual new confirmation report has not closed its native producers and original TEST binding')
terminal={'COMPLETED','FAILED','CANCELLED','TIMEOUT','OUT_OF_MEMORY','NODE_FAIL','BOOT_FAIL','PREEMPTED','DEADLINE'}
if any(record.get('state') not in terminal for record in evidence['native_accounting'].values()):
    raise IncompleteComparison('A final table cannot consume active or pending confirmation producers')
if Path(evidence['frozen_B1_roster']).resolve()!=screen_path.resolve() or Path(evidence['C1_primary_manifest']).resolve()!=primary_manifest.resolve():
    raise IncompleteComparison('Confirmation report refers to a different frozen roster or primary source')
screen=csv_rows(screen_path)
plans=csv_rows(primary_manifest.parent/'C1_TabPFN_seed2_plan.csv')
B1_plans=csv_rows(screen_path.parent/'B1_Chemprop_seed2_plan.csv')
primary_rows=csv_rows(primary_manifest.parent/'C1_primary_seed_results.csv')
def indexed(records,baseline=False):
    result={}
    for record in records:
        identity=cell_key(record,baseline)
        if identity in result:raise IncompleteComparison('Repeated actual second-seed evidence')
        result[identity]=record['evidence']
    return result
table,contrasts=finalize_c1(primary_rows,plans,indexed(evidence['C1']))
baseline=finalize_baseline_confirmations(screen,B1_plans,indexed(evidence['B1'],True))
out=b1/'C1_final_results'/('job_'+os.environ['SLURM_JOB_ID'])
if list(out.parent.glob('job_*/C1_results.csv')):
    raise IncompleteComparison('A final C1 table already exists; no independent repeat export')
safe();out.mkdir(parents=True)
def deliver(name,rows,sha=False):
    fields=list(dict.fromkeys(key for row in rows for key in row))
    stream=io.StringIO(newline='');writer=csv.DictWriter(stream,fieldnames=fields or ['status'],lineterminator='\n')
    writer.writeheader();writer.writerows(rows);payload=stream.getvalue().encode('utf-8')
    safe()
    with (out/name).open('xb') as target:target.write(payload)
    if sha:
        digest=hashlib.sha256(payload).hexdigest()
        safe()
        with (out/(name+'.sha256')).open('x') as target:target.write(digest+'  '+name+'\n')
        return digest
digest=deliver('C1_results.csv',table,True)
deliver('C1_second_seed_registered_comparisons.csv',contrasts)
deliver('B1_Chemprop_confirmation_results.csv',baseline)
report=dict(status='FINAL_C1_RESULTS_CLOSED',job=os.environ['SLURM_JOB_ID'],
    primary_configuration_rows=len(primary_rows),final_seed_rows=len(table),
    required_TabPFN_confirmations=len(plans),required_Chemprop_confirmations=len(B1_plans),
    final_C1_table=str(out/'C1_results.csv'),C1_sha256=digest,
    frozen_B1_roster=str(screen_path),primary_C1_manifest=str(primary_manifest),
    actual_confirmation_evidence=str(evidence_path),task_roster_reselection=False,
    original_primary_scores_recomputed=False,independent_numeric_QA=False,
    second_seed_control_policy='Registered original seed20261025 controls; candidate second seed20261026',
    native_second_seed_failures_remain_explicit=True)
safe();(out/'manifest.json').write_text(json.dumps(report,indent=2)+'\n')
print('FINAL_C1_RESULTS_CLOSED',out/'manifest.json','rows',len(table),'sha256',digest,flush=True)

PY
FINALC1EXPORT
